<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/UI/Styles/CluckWarsTokens.uss" />
    <ui:Style src="project://database/Assets/UI/Styles/MarkHud.uss" />

    <!-- Death Mark screen-space HUD (MarkHudController, sortingOrder 85: under the top bar 90, the touch HUD 95 and the
         overlays 100). Nothing here takes a tap. Positions are written per frame with style.translate. -->
    <ui:VisualElement name="MarkHudRoot" class="cw-markhud-root" picking-mode="Ignore">

        <!-- The Assassin's hunt marker: pinned over the target (pointer down) or at the clear-viewport edge (pointer at it). -->
        <ui:VisualElement name="HuntMarker" class="cw-mark-marker" picking-mode="Ignore">
            <!-- MarkBody holds everything the anchor scales (the 0.67 badge on the arrow, the pops, the KILL pulse). The metres
                 chip is its sibling: never in a scaled subtree, so its text stays at full size (the HUD font floor, rule U4). -->
            <ui:VisualElement name="MarkBody" class="cw-mark-body" picking-mode="Ignore">
            <ui:VisualElement name="MarkPointer" class="cw-mark-pointer" picking-mode="Ignore" />
            <ui:VisualElement name="MarkDisc" class="cw-mark-disc" picking-mode="Ignore" />
            <ui:VisualElement name="MarkRing" class="cw-mark-ring" picking-mode="Ignore" />
            <ui:VisualElement name="MarkPaw" class="cw-mark-lock cw-mark-paw" picking-mode="Ignore">
                <ui:VisualElement name="MarkSkull" class="cw-mark-skull" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:Label name="MarkArm" text="" class="cw-mark-arm" picking-mode="Ignore" />
            <ui:VisualElement name="MarkLock" class="cw-mark-lock" picking-mode="Ignore">
                <ui:VisualElement name="MarkLockGlyph" class="cw-mark-lock-glyph" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="MarkShell" class="cw-mark-lock cw-mark-shell" picking-mode="Ignore">
                <ui:VisualElement name="MarkShellGlyph" class="cw-mark-shell-glyph" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="MarkStar" class="cw-mark-lock cw-mark-star" picking-mode="Ignore">
                <ui:VisualElement name="MarkStarGlyph" class="cw-mark-star-glyph" picking-mode="Ignore" />
            </ui:VisualElement>
            </ui:VisualElement>
            <ui:Label name="MarkDistance" text="" class="cw-mark-distance" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- The victim's badge on the hunter's rival arrow (floor arrow midpoint, or just inside its edge chevron). -->
        <ui:VisualElement name="HunterSkull" class="cw-hunter-skull" picking-mode="Ignore">
            <ui:VisualElement name="HunterSkullGlyph" class="cw-hunter-skull-glyph" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- The Thief's loot-bag marker (MarkHudController.Loot): over the marked rival (pointer down), on its floor arrow outside the circle, or pinned
             to the clear-viewport edge. Only the Thief ever sees it; the lock / egg corner badges are the blocked state (a wall, a shell). -->
        <ui:VisualElement name="LootMarker" class="cw-mark-marker" picking-mode="Ignore">
            <ui:VisualElement name="LootBody" class="cw-mark-body" picking-mode="Ignore">
                <ui:VisualElement name="LootPointer" class="cw-mark-pointer" picking-mode="Ignore" />
                <ui:VisualElement name="LootDisc" class="cw-mark-disc" picking-mode="Ignore" />
                <ui:VisualElement name="LootRing" class="cw-mark-ring" picking-mode="Ignore" />
                <ui:VisualElement name="LootBag" class="cw-loot-bag" picking-mode="Ignore" />
                <ui:VisualElement name="LootLock" class="cw-mark-lock" picking-mode="Ignore">
                    <ui:VisualElement name="LootLockGlyph" class="cw-mark-lock-glyph" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement name="LootShell" class="cw-mark-lock cw-mark-shell" picking-mode="Ignore">
                    <ui:VisualElement name="LootShellGlyph" class="cw-mark-shell-glyph" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- The marked rival's own badge, over its own nameplate (a coin bag and the word LOOT), and the bag on the Thief's rival arrow (as the
             Hunt shows the skull). Only the marked rival ever sees them. -->
        <ui:VisualElement name="LootBadge" class="cw-loot-badge" picking-mode="Ignore">
            <ui:VisualElement name="LootBadgeBag" class="cw-loot-badge-bag" picking-mode="Ignore" />
            <ui:Label name="LootBadgeLabel" text="" class="cw-loot-badge-label" picking-mode="Ignore" />
        </ui:VisualElement>
        <ui:VisualElement name="LootArrowBag" class="cw-loot-arrowbag" picking-mode="Ignore">
            <ui:VisualElement name="LootArrowBagGlyph" class="cw-loot-arrowbag-glyph" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- The Warrior kits' rival tags (MarkHudController.Warrior, BL-227): beside each rival's nameplate, shown to the local Enforcer (the FRESH pill while the
             rival is fresh for it, the debt pips and their decay bar) or the local Bully (the lock while a second hit would take nothing). Four slots: a match has
             at most three rivals. Nobody else ever sees them. -->
        <ui:VisualElement name="WarriorTag0" class="cw-wtag" picking-mode="Ignore">
            <ui:VisualElement class="cw-wtag-fresh" picking-mode="Ignore">
                <ui:Label text="" class="cw-wtag-fresh-label" picking-mode="Ignore" />
                <ui:VisualElement class="cw-wbar-track" picking-mode="Ignore"><ui:VisualElement class="cw-wbar-fill cw-wbar-fill--fresh" picking-mode="Ignore" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="cw-wtag-debt" picking-mode="Ignore">
                <ui:VisualElement class="cw-wpips" picking-mode="Ignore">
                    <ui:VisualElement class="cw-wpip" picking-mode="Ignore" />
                    <ui:VisualElement class="cw-wpip" picking-mode="Ignore" />
                    <ui:VisualElement class="cw-wpip" picking-mode="Ignore" />
                    <ui:VisualElement class="cw-wpip" picking-mode="Ignore" />
                    <ui:VisualElement class="cw-wpip" picking-mode="Ignore" />
                    <ui:VisualElement class="cw-wpip" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="cw-wbar-track" picking-mode="Ignore"><ui:VisualElement class="cw-wbar-fill cw-wbar-fill--debt" picking-mode="Ignore" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="cw-wtag-lock" picking-mode="Ignore">
                <ui:VisualElement class="cw-mark-lock-glyph" picking-mode="Ignore" />
                <ui:VisualElement class="cw-wbar-track" picking-mode="Ignore"><ui:VisualElement class="cw-wbar-fill cw-wbar-fill--lock" picking-mode="Ignore" /></ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="WarriorTag1" class="cw-wtag" picking-mode="Ignore">
            <ui:VisualElement class="cw-wtag-fresh" picking-mode="Ignore">
                <ui:Label text="" class="cw-wtag-fresh-label" picking-mode="Ignore" />
                <ui:VisualElement class="cw-wbar-track" picking-mode="Ignore"><ui:VisualElement class="cw-wbar-fill cw-wbar-fill--fresh" picking-mode="Ignore" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="cw-wtag-debt" picking-mode="Ignore">
                <ui:VisualElement class="cw-wpips" picking-mode="Ignore">
                    <ui:VisualElement class="cw-wpip" picking-mode="Ignore" />
                    <ui:VisualElement class="cw-wpip" picking-mode="Ignore" />
                    <ui:VisualElement class="cw-wpip" picking-mode="Ignore" />
                    <ui:VisualElement class="cw-wpip" picking-mode="Ignore" />
                    <ui:VisualElement class="cw-wpip" picking-mode="Ignore" />
                    <ui:VisualElement class="cw-wpip" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="cw-wbar-track" picking-mode="Ignore"><ui:VisualElement class="cw-wbar-fill cw-wbar-fill--debt" picking-mode="Ignore" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="cw-wtag-lock" picking-mode="Ignore">
                <ui:VisualElement class="cw-mark-lock-glyph" picking-mode="Ignore" />
                <ui:VisualElement class="cw-wbar-track" picking-mode="Ignore"><ui:VisualElement class="cw-wbar-fill cw-wbar-fill--lock" picking-mode="Ignore" /></ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="WarriorTag2" class="cw-wtag" picking-mode="Ignore">
            <ui:VisualElement class="cw-wtag-fresh" picking-mode="Ignore">
                <ui:Label text="" class="cw-wtag-fresh-label" picking-mode="Ignore" />
                <ui:VisualElement class="cw-wbar-track" picking-mode="Ignore"><ui:VisualElement class="cw-wbar-fill cw-wbar-fill--fresh" picking-mode="Ignore" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="cw-wtag-debt" picking-mode="Ignore">
                <ui:VisualElement class="cw-wpips" picking-mode="Ignore">
                    <ui:VisualElement class="cw-wpip" picking-mode="Ignore" />
                    <ui:VisualElement class="cw-wpip" picking-mode="Ignore" />
                    <ui:VisualElement class="cw-wpip" picking-mode="Ignore" />
                    <ui:VisualElement class="cw-wpip" picking-mode="Ignore" />
                    <ui:VisualElement class="cw-wpip" picking-mode="Ignore" />
                    <ui:VisualElement class="cw-wpip" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="cw-wbar-track" picking-mode="Ignore"><ui:VisualElement class="cw-wbar-fill cw-wbar-fill--debt" picking-mode="Ignore" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="cw-wtag-lock" picking-mode="Ignore">
                <ui:VisualElement class="cw-mark-lock-glyph" picking-mode="Ignore" />
                <ui:VisualElement class="cw-wbar-track" picking-mode="Ignore"><ui:VisualElement class="cw-wbar-fill cw-wbar-fill--lock" picking-mode="Ignore" /></ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="WarriorTag3" class="cw-wtag" picking-mode="Ignore">
            <ui:VisualElement class="cw-wtag-fresh" picking-mode="Ignore">
                <ui:Label text="" class="cw-wtag-fresh-label" picking-mode="Ignore" />
                <ui:VisualElement class="cw-wbar-track" picking-mode="Ignore"><ui:VisualElement class="cw-wbar-fill cw-wbar-fill--fresh" picking-mode="Ignore" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="cw-wtag-debt" picking-mode="Ignore">
                <ui:VisualElement class="cw-wpips" picking-mode="Ignore">
                    <ui:VisualElement class="cw-wpip" picking-mode="Ignore" />
                    <ui:VisualElement class="cw-wpip" picking-mode="Ignore" />
                    <ui:VisualElement class="cw-wpip" picking-mode="Ignore" />
                    <ui:VisualElement class="cw-wpip" picking-mode="Ignore" />
                    <ui:VisualElement class="cw-wpip" picking-mode="Ignore" />
                    <ui:VisualElement class="cw-wpip" picking-mode="Ignore" />
                </ui:VisualElement>
                <ui:VisualElement class="cw-wbar-track" picking-mode="Ignore"><ui:VisualElement class="cw-wbar-fill cw-wbar-fill--debt" picking-mode="Ignore" /></ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="cw-wtag-lock" picking-mode="Ignore">
                <ui:VisualElement class="cw-mark-lock-glyph" picking-mode="Ignore" />
                <ui:VisualElement class="cw-wbar-track" picking-mode="Ignore"><ui:VisualElement class="cw-wbar-fill cw-wbar-fill--lock" picking-mode="Ignore" /></ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- The local victim's own cue while an Enforcer holds debts on it: the words YOU OWE and the count, the debt pips and their decay, bordered in the Enforcer's
             colour. Last in the file, so it draws over every rival tag (the local player's stack is on top, CODE-UI-09). -->
        <ui:VisualElement name="WarriorOwe" class="cw-wowe" picking-mode="Ignore">
            <ui:Label name="WarriorOweLabel" text="" class="cw-wowe-label" picking-mode="Ignore" />
            <ui:VisualElement class="cw-wpips" picking-mode="Ignore">
                <ui:VisualElement class="cw-wpip" picking-mode="Ignore" />
                <ui:VisualElement class="cw-wpip" picking-mode="Ignore" />
                <ui:VisualElement class="cw-wpip" picking-mode="Ignore" />
                <ui:VisualElement class="cw-wpip" picking-mode="Ignore" />
                <ui:VisualElement class="cw-wpip" picking-mode="Ignore" />
                <ui:VisualElement class="cw-wpip" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="cw-wbar-track" picking-mode="Ignore"><ui:VisualElement name="WarriorOweBar" class="cw-wbar-fill cw-wbar-fill--debt" picking-mode="Ignore" /></ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
