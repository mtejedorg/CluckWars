<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <!-- Cluck Wars : on-screen touch controls (Stage 2b rebuild, UI Toolkit).
         Left virtual joystick + right-hand MOBA arc of 3 hex ability buttons.
         Replaces the procedural-UGUI TouchControlsHud. TouchControlsController
         (senior-dev's half) drives every named element per-frame: the knob's
         translate, per-slot accent tint / cooldown clip / desaturation /
         slot-3 visibility, icon sprite, short label, slot badge, cd seconds.
         Design refs: docs/ART.md 6.6 (hex anatomy) + 6.7 (MOBA touch layout).
         Tokens: Assets/UI/Styles/CluckWarsTokens.uss (cw- vars)
         Styles: Assets/UI/Styles/TouchControls.uss
         Picking: the root is Ignore (taps outside controls fall through); only
         the joystick base + the 3 hexes are interactive (picking-mode Position).
         Cooldown is a bottom-up clip (ART 6.6 layer 6), NOT a radial fill.

         v0.6 Stage 5 (FEEDBACK.md 5.2 + 6, cases 17-19 / 24-29) adds, without a
         tenth ART-6.6 layer and without a second UIDocument:
           - per hex, an ActiveDrain* clip : layer 6 again, but anchored TOP and
             accent-tinted, i.e. the deliberate opposite of the bottom-up black
             cooldown clip, so "an ability is RUNNING" can never be misread as
             "an ability is COOLING". Shown on the active slot only.
           - per hex, a StateGlyph* group : layer 9 again. Layer 9 generalises
             from "cooldown seconds" to "state indicator" and carries whichever
             refusal won; the reasons are mutually exclusive by
             AbilityRefusalRules.Evaluate, so the centre never arbitrates. The
             marks are DRAWN (ring + rotated bars), not typed - neither U+20E0
             nor U+2715 exists in LilitaOne or NotoEmoji and TMP Settings has no
             fallback list, so both would have been tofu. See
             HudFeedbackStyle.UseDrawnRefusalMarks.
           - on the joystick, a JoyStateGlyph + JoySlowLabel. Both picking-mode
             Ignore so they can never steal a touch : the stick stays draggable
             in every control state, the GAME blocks the movement, the HUD only
             says so.
           - a StatusStrip stacked directly above the joystick base. FEEDBACK.md
             5.2 said "below the cargo readout"; that readout moved to world
             space on the chicken (ChickenWorldBars, ART 6.3 "the game area is
             sacred") and no longer exists in the HUD. Re-sited here so the strip
             reads in the SAME GLANCE as the move stick it constrains. -->
    <ui:Style src="project://database/Assets/UI/Styles/CluckWarsTokens.uss" />
    <ui:Style src="project://database/Assets/UI/Styles/TouchControls.uss" />

    <ui:VisualElement name="TouchRoot" class="cw-touch-root" picking-mode="Ignore">

        <!-- ===== LEFT : virtual joystick ===== -->
        <ui:VisualElement name="JoystickBase" class="cw-joy-base">
            <ui:VisualElement name="JoystickKnob" class="cw-joy-knob" picking-mode="Ignore" />
            <!-- Control-consequence marks. Text is written by the controller from
                 HudFeedbackStyle so the shackle here is byte-identical to the one
                 ChickenStatusBadges puts over the chicken's head. -->
            <ui:Label name="JoyStateGlyph" text="" class="cw-joy-glyph cw-glyph-font" picking-mode="Ignore" />
            <ui:Label name="JoySlowLabel" text="" class="cw-joy-slow" picking-mode="Ignore" />
        </ui:VisualElement>

        <!-- ===== LEFT : status strip (stacked above the joystick, grows upward) ===== -->
        <ui:VisualElement name="StatusStrip" class="cw-status-strip" picking-mode="Ignore">
            <ui:VisualElement name="StatusRow0" class="cw-status-row" picking-mode="Ignore">
                <ui:Label name="StatusGlyph0" text="" class="cw-status-glyph cw-glyph-font" picking-mode="Ignore" />
                <ui:Label name="StatusName0" text="" class="cw-status-name" picking-mode="Ignore" />
                <ui:Label name="StatusValue0" text="" class="cw-status-value" picking-mode="Ignore" />
                <ui:VisualElement name="StatusBar0" class="cw-status-bar" picking-mode="Ignore">
                    <ui:VisualElement name="StatusBarFill0" class="cw-status-bar-fill" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="StatusRow1" class="cw-status-row" picking-mode="Ignore">
                <ui:Label name="StatusGlyph1" text="" class="cw-status-glyph cw-glyph-font" picking-mode="Ignore" />
                <ui:Label name="StatusName1" text="" class="cw-status-name" picking-mode="Ignore" />
                <ui:Label name="StatusValue1" text="" class="cw-status-value" picking-mode="Ignore" />
                <ui:VisualElement name="StatusBar1" class="cw-status-bar" picking-mode="Ignore">
                    <ui:VisualElement name="StatusBarFill1" class="cw-status-bar-fill" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="StatusRow2" class="cw-status-row" picking-mode="Ignore">
                <ui:Label name="StatusGlyph2" text="" class="cw-status-glyph cw-glyph-font" picking-mode="Ignore" />
                <ui:Label name="StatusName2" text="" class="cw-status-name" picking-mode="Ignore" />
                <ui:Label name="StatusValue2" text="" class="cw-status-value" picking-mode="Ignore" />
                <ui:VisualElement name="StatusBar2" class="cw-status-bar" picking-mode="Ignore">
                    <ui:VisualElement name="StatusBarFill2" class="cw-status-bar-fill" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ===== RIGHT : hex ability cluster (MOBA arc) ===== -->

        <!-- Slot 1 : primary thumb anchor -->
        <ui:VisualElement name="Ability1" class="cw-hex cw-hex--a1">
            <ui:VisualElement name="Cooldown1" class="cw-hex-cd" picking-mode="Ignore">
                <ui:VisualElement class="cw-hex-cd-fill" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="ActiveDrain1" class="cw-hex-drain" picking-mode="Ignore">
                <ui:VisualElement name="ActiveDrainFill1" class="cw-hex-drain-fill" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="Icon1" class="cw-hex-icon" picking-mode="Ignore" />
            <ui:Label name="Label1" text="" class="cw-hex-label" picking-mode="Ignore" />
            <ui:Label name="CooldownNum1" text="" class="cw-hex-cdnum" picking-mode="Ignore" />
            <ui:VisualElement name="StateGlyph1" class="cw-hex-state" picking-mode="Ignore">
                <ui:VisualElement name="StateRing1" class="cw-hex-state-ring" picking-mode="Ignore" />
                <ui:VisualElement name="StateBarA1" class="cw-hex-state-bar cw-hex-state-bar--a" picking-mode="Ignore" />
                <ui:VisualElement name="StateBarB1" class="cw-hex-state-bar cw-hex-state-bar--b" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="Badge1" class="cw-hex-badge" picking-mode="Ignore">
                <ui:Label name="BadgeText1" text="1" class="cw-hex-badge-text" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Slot 2 : arc above-left -->
        <ui:VisualElement name="Ability2" class="cw-hex cw-hex--a2">
            <ui:VisualElement name="Cooldown2" class="cw-hex-cd" picking-mode="Ignore">
                <ui:VisualElement class="cw-hex-cd-fill" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="ActiveDrain2" class="cw-hex-drain" picking-mode="Ignore">
                <ui:VisualElement name="ActiveDrainFill2" class="cw-hex-drain-fill" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="Icon2" class="cw-hex-icon" picking-mode="Ignore" />
            <ui:Label name="Label2" text="" class="cw-hex-label" picking-mode="Ignore" />
            <ui:Label name="CooldownNum2" text="" class="cw-hex-cdnum" picking-mode="Ignore" />
            <ui:VisualElement name="StateGlyph2" class="cw-hex-state" picking-mode="Ignore">
                <ui:VisualElement name="StateRing2" class="cw-hex-state-ring" picking-mode="Ignore" />
                <ui:VisualElement name="StateBarA2" class="cw-hex-state-bar cw-hex-state-bar--a" picking-mode="Ignore" />
                <ui:VisualElement name="StateBarB2" class="cw-hex-state-bar cw-hex-state-bar--b" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="Badge2" class="cw-hex-badge" picking-mode="Ignore">
                <ui:Label name="BadgeText2" text="2" class="cw-hex-badge-text" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Slot 3 : available to every class since v0.7's four-slot loadouts. The gold
             star badge is gone with the Combo passive that justified it - and U+2605 was
             in neither shipped font, surviving only on OS fallback. -->
        <ui:VisualElement name="Ability3" class="cw-hex cw-hex--a3">
            <ui:VisualElement name="Cooldown3" class="cw-hex-cd" picking-mode="Ignore">
                <ui:VisualElement class="cw-hex-cd-fill" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="ActiveDrain3" class="cw-hex-drain" picking-mode="Ignore">
                <ui:VisualElement name="ActiveDrainFill3" class="cw-hex-drain-fill" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="Icon3" class="cw-hex-icon" picking-mode="Ignore" />
            <ui:Label name="Label3" text="" class="cw-hex-label" picking-mode="Ignore" />
            <ui:Label name="CooldownNum3" text="" class="cw-hex-cdnum" picking-mode="Ignore" />
            <ui:VisualElement name="StateGlyph3" class="cw-hex-state" picking-mode="Ignore">
                <ui:VisualElement name="StateRing3" class="cw-hex-state-ring" picking-mode="Ignore" />
                <ui:VisualElement name="StateBarA3" class="cw-hex-state-bar cw-hex-state-bar--a" picking-mode="Ignore" />
                <ui:VisualElement name="StateBarB3" class="cw-hex-state-bar cw-hex-state-bar--b" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="Badge3" class="cw-hex-badge" picking-mode="Ignore">
                <ui:Label name="BadgeText3" text="3" class="cw-hex-badge-text" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Slot 4 : added with v0.7's four-slot loadouts. On every class except Assassin
             this is where Peck (foraging) most often sits, but the player assigns it. -->
        <ui:VisualElement name="Ability4" class="cw-hex cw-hex--a4">
            <ui:VisualElement name="Cooldown4" class="cw-hex-cd" picking-mode="Ignore">
                <ui:VisualElement class="cw-hex-cd-fill" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="ActiveDrain4" class="cw-hex-drain" picking-mode="Ignore">
                <ui:VisualElement name="ActiveDrainFill4" class="cw-hex-drain-fill" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="Icon4" class="cw-hex-icon" picking-mode="Ignore" />
            <ui:Label name="Label4" text="" class="cw-hex-label" picking-mode="Ignore" />
            <ui:Label name="CooldownNum4" text="" class="cw-hex-cdnum" picking-mode="Ignore" />
            <ui:VisualElement name="StateGlyph4" class="cw-hex-state" picking-mode="Ignore">
                <ui:VisualElement name="StateRing4" class="cw-hex-state-ring" picking-mode="Ignore" />
                <ui:VisualElement name="StateBarA4" class="cw-hex-state-bar cw-hex-state-bar--a" picking-mode="Ignore" />
                <ui:VisualElement name="StateBarB4" class="cw-hex-state-bar cw-hex-state-bar--b" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement name="Badge4" class="cw-hex-badge" picking-mode="Ignore">
                <ui:Label name="BadgeText4" text="4" class="cw-hex-badge-text" picking-mode="Ignore" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>