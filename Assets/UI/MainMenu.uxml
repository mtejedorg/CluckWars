<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/UI/Styles/CluckWarsTheme.uss" />

    <ui:VisualElement name="MainMenuPage" class="cw-screen cw-page" style="align-items: center; justify-content: center;">

        <ui:VisualElement style="align-items: center; margin-bottom: 36px;">
            <ui:Label text="CLUCK WARS" class="cw-title cw-accent" style="font-size: 72px; letter-spacing: 4px;" />
            <ui:Label text="4-PLAYER FARMYARD FREE-FOR-ALL" class="cw-body" style="font-size: 18px; letter-spacing: 2px; margin-top: 4px;" />
        </ui:VisualElement>

        <ui:VisualElement name="ModeRow" class="cw-mode-row" style="align-items: center; justify-content: center;">
            <ui:Button name="SoloBtn" text="SOLO" class="cw-btn cw-btn--gold" style="min-width: 220px; margin-left: 8px; margin-right: 8px; margin-bottom: 8px; font-size: 26px;" />
            <ui:Button name="HostBtn" text="HOST" class="cw-btn cw-btn--green" style="min-width: 220px; margin-left: 8px; margin-right: 8px; margin-bottom: 8px; font-size: 26px;" />
            <ui:Button name="JoinBtn" text="JOIN" class="cw-btn cw-btn--neutral" style="min-width: 220px; margin-left: 8px; margin-right: 8px; margin-bottom: 8px; font-size: 26px;" />
        </ui:VisualElement>

        <ui:Label name="MainMenuHint" text="Pick a mode to choose your chicken." class="cw-body" style="margin-top: 16px; min-height: 22px;" />
    </ui:VisualElement>
</ui:UXML>
