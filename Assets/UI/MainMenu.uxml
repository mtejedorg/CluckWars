<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <!-- Cluck Wars — main menu (2026-07-24 redesign).

         The previous version was a text screen for a game about chickens: title,
         subtitle and three identical pills in a ~250px band, with ~430px of dead
         black above and ~350px below, while every art atom the project ships
         (4 chicken sprites, RadialGlow, GlossOverlay) went unused.

         Three changes:

         1. CAST BAND. The four chickens are the product. Showing them says
            "4-player, pick a chicken" faster than the subtitle does, costs no new
            art, and fills the void that made the old screen feel unfinished.
         2. ONE PRIMARY ACTION. SOLO is the instant-play path and the one a
            playtester takes almost every time, so it is the single green CTA on
            its own row; HOST/JOIN are wood secondaries beneath it (stage 2 button
            rule: green = forward, wood = navigation/secondary, gold = selection).
         3. A PAINTED BACKDROP. The shared backdrop MenuUiController puts behind
            every page (Phase 2: Bg_MainMenu here). Text that sits directly on the
            bright art (subtitle, cast names, solo hint) is on an ink plate
            (.cw-art-plate) so it keeps WCAG-AA contrast over the sky and sun.

         Settings (stage 2): the gear at the top-right opens #SettingsSheet, a
         modal over this page with the four PlayerPreferences toggles. It replaced
         the two toggles that used to sit on the loadout screen.

         Sizes follow the mobile contract at the top of CluckWarsTheme.uss. -->
    <ui:Style src="project://database/Assets/UI/Styles/CluckWarsTheme.uss" />
    <ui:Style src="project://database/Assets/UI/Styles/CategoryMark.uss" />

    <ui:VisualElement name="MainMenuPage" class="cw-screen cw-page cw-menu">

        <!-- ── Title ── -->
        <ui:VisualElement class="cw-menu-titleblock" picking-mode="Ignore">
            <ui:Label text="@main.title" class="cw-title cw-accent cw-menu-title" />
            <ui:Label text="@main.subtitle" class="cw-body cw-on-art cw-art-plate cw-menu-subtitle" />
        </ui:VisualElement>

        <!-- ── Cast band: the four playable chickens ── -->
        <ui:VisualElement name="CastBand" class="cw-menu-cast" picking-mode="Ignore">
            <ui:VisualElement class="cw-menu-cast__item">
                <ui:VisualElement class="cw-chicken cw-chicken--warrior cw-menu-cast__art" />
                <ui:Label text="@class.warrior.short" class="cw-art-plate cw-menu-cast__name cw-menu-cast__name--warrior" />
            </ui:VisualElement>
            <ui:VisualElement class="cw-menu-cast__item">
                <ui:VisualElement class="cw-chicken cw-chicken--speedy cw-menu-cast__art" />
                <ui:Label text="@class.speedy.short" class="cw-art-plate cw-menu-cast__name cw-menu-cast__name--speedy" />
            </ui:VisualElement>
            <ui:VisualElement class="cw-menu-cast__item">
                <ui:VisualElement class="cw-chicken cw-chicken--fatty cw-menu-cast__art" />
                <ui:Label text="@class.fatty.short" class="cw-art-plate cw-menu-cast__name cw-menu-cast__name--fatty" />
            </ui:VisualElement>
            <ui:VisualElement class="cw-menu-cast__item">
                <ui:VisualElement class="cw-chicken cw-chicken--assassin cw-menu-cast__art" />
                <ui:Label text="@class.assassin.short" class="cw-art-plate cw-menu-cast__name cw-menu-cast__name--assassin" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ── Actions: one primary, two secondary ── -->
        <ui:VisualElement class="cw-menu-actions">
            <!-- PLAY AGAIN: one tap back to THE COOP with the last class / perk / loadout
                 (never auto-starts). Hidden by MenuUiController when there is no valid last
                 setup. #PlayAgainSub is filled from btn.playAgain.sub ("{cls} · {perk}").
                 Phase 1: one wood plank with the sub-line UNDER the label, inside the button,
                 so the whole two-line block is the touch target and the sub-line reads on
                 wood (cream + ink outline) rather than on the busy backdrop.
                 Phase 4: it sits ABOVE PLAY SOLO and, while shown, is the green primary (PLAY SOLO
                 drops to wood); MenuUiController.RefreshPlayAgain swaps the classes. -->
            <ui:VisualElement name="PlayAgainRow" class="cw-menu-playagain" style="display: none;">
                <ui:Button name="PlayAgainBtn" class="cw-btn cw-btn--wood cw-menu-playagain__btn">
                    <ui:Label text="@btn.playAgain" class="cw-menu-playagain__label" picking-mode="Ignore" />
                    <ui:Label name="PlayAgainSub" text="" class="cw-menu-playagain__sub" picking-mode="Ignore" />
                </ui:Button>
            </ui:VisualElement>
            <ui:Button name="SoloBtn" text="@btn.playSolo" class="cw-btn cw-btn--green cw-menu-primary" />
            <ui:VisualElement name="ModeRow" class="cw-mode-row cw-menu-secondary-row">
                <ui:Button name="HostBtn" text="@btn.host" class="cw-btn cw-btn--wood cw-menu-secondary" />
                <ui:Button name="JoinBtn" text="@btn.join" class="cw-btn cw-btn--wood cw-menu-secondary" />
            </ui:VisualElement>
            <ui:Label name="MainMenuHint" text="@main.soloHint" class="cw-body cw-on-art cw-art-plate cw-menu-hint" />

            <!-- Developer tools. Hidden unless PlayerPreferences.DeveloperModeEnabled,
                 which defaults to OFF and is set from the Dev Mode toggle in the
                 Settings sheet below.

                 This is the ONLY route into AbilityLab.unity, which is enabled in Build
                 Settings so it can be launched on a phone — there is no Editor menu on a
                 device. MenuUiController re-reads the preference every time the main menu
                 is shown AND whenever the toggle changes or the sheet closes, so the row
                 appears or disappears without a relaunch.
                 Display is driven from C#; do not give it a display rule in USS or the two
                 will fight. -->
            <ui:VisualElement name="DevRow" class="cw-menu-secondary-row" style="display: none;">
                <ui:Button name="AbilityLabBtn" text="@btn.abilityLab" class="cw-btn cw-btn--wood cw-menu-secondary" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Build stamp — during a test session you otherwise cannot tell which
             build is on the device. Filled by MenuUiController. -->
        <ui:Label name="BuildStamp" text="" class="cw-menu-build" picking-mode="Ignore" />

        <!-- Settings gear (wood nav button, top-right). The gear is a sprite (Icons/Glyph_Gear.png;
             Phase 2: no emoji glyphs in menus); the tooltip is its accessible name
             (UiText.ResolveTree resolves @keys in tooltips too). -->
        <ui:Button name="SettingsBtn" tooltip="@settings.title" class="cw-home-btn cw-gear-btn">
            <ui:VisualElement class="cw-gear-btn__icon" picking-mode="Ignore" />
        </ui:Button>

        <!-- Settings sheet (modal). Hidden until SettingsBtn is pressed
             (MenuUiController.OpenSettings). The scrim swallows taps behind the
             sheet; CLOSE or a tap on the scrim closes it. Each row is one whole
             touch target - MenuUiController.BindSettingRow flips its Toggle on a
             tap anywhere in the row. Display is driven from C#. -->
        <ui:VisualElement name="SettingsSheet" class="cw-sheet-scrim" style="display: none;">
            <ui:VisualElement name="SettingsPanel" class="cw-sheet cw-wood-panel">
                <ui:VisualElement class="cw-sheet__head">
                    <ui:VisualElement class="cw-ribbon">
                        <ui:Label text="@settings.title" class="cw-title" />
                    </ui:VisualElement>
                    <ui:Button name="SettingsCloseBtn" text="@settings.close" class="cw-btn cw-btn--wood cw-sheet__close" />
                </ui:VisualElement>
                <ui:VisualElement class="cw-sheet__body cw-raised">
                    <ui:VisualElement name="RangeGuidesRow" class="cw-setting-toggle-row">
                        <ui:VisualElement class="cw-setting-toggle-row__texts">
                            <ui:Label text="@settings.rangeGuides" class="cw-setting-toggle-row__name" />
                            <ui:Label text="@settings.rangeGuides.desc" class="cw-setting-toggle-row__desc" />
                        </ui:VisualElement>
                        <ui:Toggle name="RangeGuidesToggle" class="cw-opt-toggle" />
                    </ui:VisualElement>
                    <ui:VisualElement name="ReducedMotionRow" class="cw-setting-toggle-row">
                        <ui:VisualElement class="cw-setting-toggle-row__texts">
                            <ui:Label text="@settings.reducedMotion" class="cw-setting-toggle-row__name" />
                            <ui:Label text="@settings.reducedMotion.desc" class="cw-setting-toggle-row__desc" />
                        </ui:VisualElement>
                        <ui:Toggle name="ReducedMotionToggle" class="cw-opt-toggle" />
                    </ui:VisualElement>
                    <ui:VisualElement name="PerformanceModeRow" class="cw-setting-toggle-row">
                        <ui:VisualElement class="cw-setting-toggle-row__texts">
                            <ui:Label text="@settings.performance" class="cw-setting-toggle-row__name" />
                            <ui:Label text="@settings.performance.desc" class="cw-setting-toggle-row__desc" />
                        </ui:VisualElement>
                        <ui:Toggle name="PerformanceModeToggle" class="cw-opt-toggle" />
                    </ui:VisualElement>
                    <ui:VisualElement name="DeveloperModeRow" class="cw-setting-toggle-row cw-setting-toggle-row--last">
                        <ui:VisualElement class="cw-setting-toggle-row__texts">
                            <ui:Label text="@settings.devMode" class="cw-setting-toggle-row__name" />
                            <ui:Label text="@settings.devMode.desc" class="cw-setting-toggle-row__desc" />
                        </ui:VisualElement>
                        <ui:Toggle name="DeveloperModeToggle" class="cw-opt-toggle" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
