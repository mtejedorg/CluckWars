<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <!-- Cluck Wars — STEP 2 "GEAR UP" (menu overhaul Phase 1, 2026-10-06).

         Four slot cards on top; the pool below as ONE art-forward card deck in two groups
         (ANY BIRD, {CLS} ONLY) that sit side by side and wrap to a second line only where the
         screen is too narrow — no page scroll on any target size. Each card wears its category
         colour as its frame. Tap a card = show its details in the bottom bar AND equip it into
         the armed slot; the armed slot carries a NEXT caret; locked starters show the padlock.

         Root name CharacterSelectPage is kept so the scene reference (_characterSelectUxml)
         keeps resolving. Built ONCE (slots) / once per class (cards) by MenuUiController;
         taps only toggle classes and labels. Binding contract (by name):
           BackBtn, ReadyBtn, SlotBox0..3, CommonTitle/CommonCards, ClassTitle/ClassCards,
           AbilityDetail, AbilityDetailName, AbilityDetailCat, AbilityDetailCd, AbilityDetailText

         Sizes follow the MOBILE SIZING CONTRACT at the top of CluckWarsTheme.uss. -->
    <ui:Style src="project://database/Assets/UI/Styles/CluckWarsTheme.uss" />

    <ui:VisualElement name="CharacterSelectPage" class="cw-screen cw-page">

        <ui:VisualElement class="cw-page-header">
            <ui:Button name="BackBtn" text="@nav.back" class="cw-home-btn" />
            <ui:VisualElement class="cw-ribbon">
                <ui:Label text="@screen.loadout.title" class="cw-title" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="Body" class="cw-gear-body">

            <ui:VisualElement name="SlotBoxRow" class="cw-slot-box-row">
                <ui:Button name="SlotBox0" class="cw-slot-box" />
                <ui:Button name="SlotBox1" class="cw-slot-box" />
                <ui:Button name="SlotBox2" class="cw-slot-box" />
                <ui:Button name="SlotBox3" class="cw-slot-box" />
            </ui:VisualElement>

            <ui:VisualElement name="Deck" class="cw-deck">
                <ui:VisualElement name="CommonRow" class="cw-deck-group">
                    <ui:Label name="CommonTitle" text="@loadout.row.shared" class="cw-deck-group__title" />
                    <ui:VisualElement name="CommonCards" class="cw-deck-cards" />
                </ui:VisualElement>
                <ui:VisualElement name="ClassRow" class="cw-deck-group">
                    <ui:Label name="ClassTitle" text="" class="cw-deck-group__title" />
                    <ui:VisualElement name="ClassCards" class="cw-deck-cards" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Bottom bar: the tapped move's details share the row with READY instead of
                 owning a permanent strip of their own. -->
            <ui:VisualElement name="BottomBar" class="cw-gear-bottom">
                <ui:VisualElement name="AbilityDetail" class="cw-ability-detail">
                    <ui:VisualElement class="cw-ability-detail__head">
                        <ui:Label name="AbilityDetailName" text="" class="cw-ability-detail__name" />
                        <ui:Label name="AbilityDetailCat" text="" class="cw-cat-tag" />
                        <ui:Label name="AbilityDetailCd" text="" class="cw-cd-badge" />
                    </ui:VisualElement>
                    <ui:Label name="AbilityDetailText" text="@loadout.detail.empty" class="cw-ability-detail__text" />
                </ui:VisualElement>
                <ui:Button name="ReadyBtn" text="" class="cw-btn cw-btn--green cw-gear-ready" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:Label name="ConsoleHints" text="@hint.console" class="cw-body cw-on-art cw-console-hints" style="position: absolute; bottom: 12px; left: 24px; opacity: 0.6; display: none;" />
    </ui:VisualElement>
</ui:UXML>
