/* ============================================================================
   Death Mark HUD (MarkHud.uxml + MarkHudController). Panel px on the shared HUD
   panel (ScaleWithScreenSize 1920x1080, match 0.5). The C# side writes only
   style.translate / scale / rotate / opacity / tint per frame; every box is here.
   Ring and pointer are Painter2D (numbers in FeedbackTuning: MarkRing*, MarkPointer*).
   ============================================================================ */

.cw-markhud-root {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
}

/* 144 x 144 box (1.5x the old 96), translated so its centre sits on the anchor (the controller subtracts the half). Every
   px below and the px constants in FeedbackTuning (MarkRing*, MarkPointer*, MarkMarker*) are scaled together: MarkMarkerGeometryTests. */
.cw-mark-marker {
    position: absolute; left: 0; top: 0;
    width: 144px; height: 144px;
    display: none;
}

/* Everything the anchor scales; the metres chip is its sibling (never scaled by the box). */
.cw-mark-body {
    position: absolute; left: 0; top: 0;
    width: 144px; height: 144px;
}

.cw-mark-pointer, .cw-mark-ring {
    position: absolute; left: 0; top: 0;
    width: 144px; height: 144px;
}

.cw-mark-disc {
    position: absolute; left: 21px; top: 21px;
    width: 102px; height: 102px;
    border-top-left-radius: 51px; border-top-right-radius: 51px;
    border-bottom-left-radius: 51px; border-bottom-right-radius: 51px;
    background-color: rgb(20, 10, 26);
}

/* The hunter-side marker's paw is the Hunting glyph (Glyph_Hunting, cream: the controller tints it the state colour), now a
   corner badge (MarkPaw, top-left, the mirror of the lock badge) so the disc centre can hold the count for the whole hunt.
   The victim's badge (.cw-hunter-skull-glyph below) keeps the skull. */
.cw-mark-skull {
    width: 36px; height: 36px;
    background-image: url("project://database/Assets/_Game/Art/UI/Icons/States/Glyph_Hunting.png");
    -unity-background-scale-mode: scale-to-fit;
}

/* The count in the disc centre, the whole hunt: 3, 2, 1 while arming, then whole seconds and tenths, in the state colour. */
.cw-mark-arm {
    position: absolute; left: 21px; top: 21px;
    width: 102px; height: 102px;
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/LilitaOne-Regular.ttf");
    font-size: 60px;
    color: rgb(254, 245, 224);
    -unity-text-outline-width: 4px;
    -unity-text-outline-color: rgb(42, 26, 12);
    -unity-text-align: middle-center;
    white-space: nowrap;
    padding: 0; margin: 0;
    display: none;
}

/* The corner badges: 51 px ink discs on the ring, centred +-39 from the box centre. Bottom-right (MarkLock, MarkShell, MarkStar):
   what blocks the pounce once the mark is live. Top-left (MarkPaw): the Hunting paw, the whole hunt. */
.cw-mark-lock {
    position: absolute; left: 85.5px; top: 85.5px;
    width: 51px; height: 51px;
    border-top-left-radius: 25.5px; border-top-right-radius: 25.5px;
    border-bottom-left-radius: 25.5px; border-bottom-right-radius: 25.5px;
    background-color: rgb(20, 10, 26);
    align-items: center; justify-content: center;
    display: none;
}
.cw-mark-lock-glyph {
    width: 36px; height: 36px;
    background-image: url("project://database/Assets/_Game/Art/UI/Icons/Glyph_Lock.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(254, 245, 224);
}

/* Top-left: the same badge, shown by the controller for the whole hunt. */
.cw-mark-paw { left: 7.5px; top: 7.5px; }

/* Not stunned (the pounce needs a stunned target): the same badge with the Stunned state glyph, cream. */
.cw-mark-star-glyph {
    width: 40px; height: 40px;
    background-image: url("project://database/Assets/_Game/Art/UI/Icons/States/Glyph_Stunned.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(254, 245, 224);
}

/* Shelled only (the target is steal-proof and cannot be executed): the same badge, the two-tone ShieldEgg state glyph on cream (untinted). */
.cw-mark-shell { background-color: rgb(254, 245, 224); }
.cw-mark-shell-glyph {
    width: 42px; height: 42px;
    background-image: url("project://database/Assets/_Game/Art/UI/Icons/States/Glyph_ShieldEgg.png");
    -unity-background-scale-mode: scale-to-fit;
}

/* The metres chip, whenever a mark is shown: above the disc on screen; off screen on the inward vertical side (the controller
   moves it above when the bearing points down). Red when the target is beyond the kill range. It stays 34 px text (a label is
   not scaled with the box): the 0.85 appear pop must keep it at or above the 28 px HUD floor. An ink pill backs it so it reads on
   grass and over a bird; it is centred on the box (left 72 + translate -50%) and "999 m" is ~134 px wide. */
.cw-mark-distance {
    position: absolute; left: 72px; top: 152px;
    translate: -50% 0;
    min-width: 64px; height: 42px;
    padding-left: 14px; padding-right: 14px;
    background-color: rgba(20, 10, 26, 0.88);
    border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px;
    border-left-color: rgba(254, 245, 224, 0.4); border-right-color: rgba(254, 245, 224, 0.4);
    border-top-color: rgba(254, 245, 224, 0.4); border-bottom-color: rgba(254, 245, 224, 0.4);
    border-top-left-radius: 21px; border-top-right-radius: 21px;
    border-bottom-left-radius: 21px; border-bottom-right-radius: 21px;
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/LilitaOne-Regular.ttf");
    font-size: 34px;
    color: rgb(254, 245, 224);
    -unity-text-outline-width: 4px;
    -unity-text-outline-color: rgb(42, 26, 12);
    -unity-text-align: middle-center;
    white-space: nowrap;
    padding: 0; margin: 0;
    display: none;
}
.cw-mark-distance--above { top: -48px; }
/* Beyond the kill range the pill goes red with cream text (the Hunt hex's far chip, .cw-hex-huntfar): dark red on the ink pill did not
   read. The red is FeedbackTuning.MarkHuntBlockedColor (a test pins it); the text colour is set inline by HuntRules.ChipTextColour. */
.cw-mark-distance--far {
    background-color: rgb(230, 10, 10);
    border-left-color: rgb(254, 245, 224); border-right-color: rgb(254, 245, 224);
    border-top-color: rgb(254, 245, 224); border-bottom-color: rgb(254, 245, 224);
}

/* The victim's hunter-skull badge: 44 px ink disc, 3 px border in the hunter's colour (set by the controller), cream skull. */
.cw-hunter-skull {
    position: absolute; left: 0; top: 0;
    width: 44px; height: 44px;
    border-top-left-radius: 22px; border-top-right-radius: 22px;
    border-bottom-left-radius: 22px; border-bottom-right-radius: 22px;
    border-left-width: 3px; border-right-width: 3px; border-top-width: 3px; border-bottom-width: 3px;
    background-color: rgb(20, 10, 26);
    align-items: center; justify-content: center;
    display: none;
}
.cw-hunter-skull-glyph {
    width: 30px; height: 30px;
    background-image: url("project://database/Assets/_Game/Art/UI/Icons/Glyph_Skull.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(254, 245, 224);
}

/* ============================================================================
   Thief loot mark (MarkHudController.Loot). The marker reuses the hunt marker's boxes (.cw-mark-marker, -body, -pointer, -ring, -disc and the lock / egg
   corner badges); the bag is painted by CoinBagGlyph (Painter2D, a placeholder for the 2D artist), so it needs no sprite. Colours come from the feedback
   palette in code (LootGoldColor); the values below are the ink and cream of the shared look.
   ============================================================================ */

/* The bag on the disc: the disc's 102 px square. */
.cw-loot-bag {
    position: absolute; left: 21px; top: 21px;
    width: 102px; height: 102px;
}

/* The marked rival's own badge: an ink pill with the bag and the word LOOT, centred on the anchor the controller writes (above its nameplate). The
   label is 28 px, the HUD font floor (rule U4); the border colour is written inline from the palette. */
.cw-loot-badge {
    position: absolute; left: 0; top: 0;
    height: 52px;
    padding-left: 8px; padding-right: 16px;
    flex-direction: row; align-items: center;
    background-color: rgba(20, 10, 26, 0.9);
    border-left-width: 3px; border-right-width: 3px; border-top-width: 3px; border-bottom-width: 3px;
    border-top-left-radius: 26px; border-top-right-radius: 26px;
    border-bottom-left-radius: 26px; border-bottom-right-radius: 26px;
    display: none;
}
.cw-loot-badge-bag { width: 40px; height: 40px; }
.cw-loot-badge-label {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/LilitaOne-Regular.ttf");
    font-size: 28px;
    color: rgb(254, 245, 224);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(42, 26, 12);
    -unity-text-align: middle-left;
    white-space: nowrap;
    padding: 0; margin: 0; margin-left: 6px;
}

/* The bag on the Thief's arrow (the victim's view): the hunter skull's 44 px ink disc, a gold border written inline. */
.cw-loot-arrowbag {
    position: absolute; left: 0; top: 0;
    width: 44px; height: 44px;
    border-top-left-radius: 22px; border-top-right-radius: 22px;
    border-bottom-left-radius: 22px; border-bottom-right-radius: 22px;
    border-left-width: 3px; border-right-width: 3px; border-top-width: 3px; border-bottom-width: 3px;
    background-color: rgb(20, 10, 26);
    align-items: center; justify-content: center;
    display: none;
}
.cw-loot-arrowbag-glyph { width: 32px; height: 32px; }

/* ============================================================================
   Warrior kit feedback (MarkHudController.Warrior, BL-227): the rival tags (the Enforcer's FRESH pill and debt pips, the Bully's lock) and the victim's
   YOU OWE cue. Palette colours (WarriorFreshColor, WarriorDebtColor, WarriorLockColor, the Enforcer's player colour) are written inline by the controller;
   the values below are the ink and cream of the shared look and the fallback fills. Text is 28 px, the HUD font floor (rule U4).
   ============================================================================ */

/* One tag: a column beside the rival's nameplate (the controller writes its translate), as wide as its content. */
.cw-wtag {
    position: absolute; left: 0; top: 0;
    flex-direction: column; align-items: center;
    display: none;
}

/* The FRESH pill: the word and, under it, the draining window. */
.cw-wtag-fresh {
    min-width: 140px;
    padding: 4px 16px 8px 16px;
    margin-bottom: 6px;
    flex-direction: column; align-items: stretch;
    background-color: rgba(20, 10, 26, 0.92);
    border-left-width: 3px; border-right-width: 3px; border-top-width: 3px; border-bottom-width: 3px;
    border-left-color: rgb(254, 245, 224); border-right-color: rgb(254, 245, 224); border-top-color: rgb(254, 245, 224); border-bottom-color: rgb(254, 245, 224);
    border-top-left-radius: 24px; border-top-right-radius: 24px;
    border-bottom-left-radius: 24px; border-bottom-right-radius: 24px;
    display: none;
}
.cw-wtag-fresh-label {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/LilitaOne-Regular.ttf");
    font-size: 28px;
    color: rgb(254, 245, 224);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(42, 26, 12);
    -unity-text-align: middle-center;
    white-space: nowrap;
    padding: 0; margin: 0;
}

/* The debts: the pips (the cap is drawn, the held ones filled) over the decay bar. */
.cw-wtag-debt {
    padding: 8px 14px 8px 14px;
    flex-direction: column; align-items: stretch;
    background-color: rgba(20, 10, 26, 0.88);
    border-top-left-radius: 20px; border-top-right-radius: 20px;
    border-bottom-left-radius: 20px; border-bottom-right-radius: 20px;
    display: none;
}
.cw-wpips { flex-direction: row; justify-content: center; align-items: center; margin-bottom: 6px; }
.cw-wpip {
    width: 26px; height: 26px; margin: 0 3px;
    border-left-width: 3px; border-right-width: 3px; border-top-width: 3px; border-bottom-width: 3px;
    border-left-color: rgb(254, 245, 224); border-right-color: rgb(254, 245, 224); border-top-color: rgb(254, 245, 224); border-bottom-color: rgb(254, 245, 224);
    border-top-left-radius: 13px; border-top-right-radius: 13px;
    border-bottom-left-radius: 13px; border-bottom-right-radius: 13px;
    background-color: rgba(20, 10, 26, 0.6);
    display: none;
}

/* A draining bar: the track is the whole window, the fill is what is left (the controller writes its width in percent). */
.cw-wbar-track {
    height: 8px;
    background-color: rgba(254, 245, 224, 0.25);
    border-top-left-radius: 4px; border-top-right-radius: 4px;
    border-bottom-left-radius: 4px; border-bottom-right-radius: 4px;
}
.cw-wbar-fill {
    height: 8px; width: 100%;
    background-color: rgb(254, 245, 224);
    border-top-left-radius: 4px; border-top-right-radius: 4px;
    border-bottom-left-radius: 4px; border-bottom-right-radius: 4px;
}
.cw-wbar-fill--fresh { background-color: rgb(77, 242, 204); }
.cw-wbar-fill--debt { background-color: rgb(255, 133, 31); }
.cw-wbar-fill--lock { background-color: rgb(140, 168, 242); }

/* The Bully's lock: the shared lock glyph over the draining bar, faint by design (the lock is information, not an alarm). */
.cw-wtag-lock {
    margin-top: 6px;
    padding: 6px 14px 8px 14px;
    width: 96px;
    flex-direction: column; align-items: center;
    background-color: rgba(20, 10, 26, 0.7);
    border-top-left-radius: 20px; border-top-right-radius: 20px;
    border-bottom-left-radius: 20px; border-bottom-right-radius: 20px;
    display: none;
}
.cw-wtag-lock .cw-wbar-track { align-self: stretch; margin-top: 4px; }

/* The victim's cue, beside its own nameplate (the stack above it belongs to the status badges, the pops and the loot badge), bordered in the Enforcer's colour (written inline). */
.cw-wowe {
    position: absolute; left: 0; top: 0;
    padding: 6px 18px 8px 18px;
    flex-direction: column; align-items: stretch;
    background-color: rgba(20, 10, 26, 0.92);
    border-left-width: 4px; border-right-width: 4px; border-top-width: 4px; border-bottom-width: 4px;
    border-left-color: rgb(255, 133, 31); border-right-color: rgb(255, 133, 31); border-top-color: rgb(255, 133, 31); border-bottom-color: rgb(255, 133, 31);
    border-top-left-radius: 26px; border-top-right-radius: 26px;
    border-bottom-left-radius: 26px; border-bottom-right-radius: 26px;
    display: none;
}
.cw-wowe-label {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/LilitaOne-Regular.ttf");
    font-size: 28px;
    color: rgb(254, 245, 224);
    -unity-text-outline-width: 3px;
    -unity-text-outline-color: rgb(42, 26, 12);
    -unity-text-align: middle-center;
    white-space: nowrap;
    padding: 0; margin: 0 0 4px 0;
}
