/* ============================================================================
   Cluck Wars : match top-bar HUD (Stage 2a + Stage A UI rebuild)
   Consumed by Assets/UI/MatchTopBar.uxml + MatchHudController.cs.
   Design source: docs/ART.md 6.3 + Design CWMatchHUDv3L

   2026-07-23 Android pass: every size below is ~1.9x the Stage-2a sheet.
   See the mobile sizing contract at the top of CluckWarsTheme.uss — on this
   1920x1080 canvas 1 dp ~= 2.35 px, so the old 14-18 px HUD type rendered at
   6-8 sp on a phone. The leaderboard is glanceable rather than body copy, so
   it sits at 26-34 px (11-14 sp) instead of the menu ramp; that is the
   deliberate floor for a HUD that must not eat the arena. The strip grew
   180 -> 300 px, which is the cost of a readable scoreboard.
   ============================================================================ */

/* ---- Full-width transparent top strip (dark to clear fade) ---------------- */
.cw-topbar {
    position: absolute; left: 0; top: 0; right: 0;
    height: 330px;
    background-image: url("project://database/Assets/_Game/Art/UI/Backgrounds/HudTopGradient.png");
    -unity-background-scale-mode: stretch-to-fill;
}

/* Intro countdown (ART.md 6.5): top bar stays visible but recedes to 40%
   opacity behind the "GET READY" overlay. Toggled by MatchHudController
   from MatchOverlaysController's intro-countdown state. */
.cw-topbar--dimmed {
    opacity: 0.4;
}
/* Under the match-end / in-session lobby modals (MatchHudController.SetHiddenByModal). */
.cw-topbar--hidden {
    display: none;
}

.cw-topbar-layout {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    padding-top: 20px; padding-left: 20px; padding-right: 20px;
    width: 100%;
}

/* ============================================================================
   LEFT: RANKED LEADERBOARD PANEL + TARGET BADGE
   ============================================================================ */
.cw-lb-container {
    flex-direction: column;
    align-items: flex-start;
}

.cw-lb-panel {
    background-color: rgba(20, 14, 8, 0.85);
    border-radius: 14px;
    padding: 10px;
    /* Optional border for the whole panel */
    border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px;
    border-color: rgba(60, 45, 30, 0.8);
}

.cw-lb-row {
    flex-direction: row;
    align-items: center;
    height: 64px;
    padding-left: 10px; padding-right: 14px;
    margin-bottom: 6px;
    border-radius: 8px;
    border-left-width: 5px;
    border-left-color: transparent; /* Updated by controller for local player */
}

/* Faint gold wash for the leader, applied dynamically by controller if needed */
.cw-lb-row--leader {
    background-color: rgba(245, 200, 66, 0.15);
}

.cw-lb-ord {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/LilitaOne-Regular.ttf");
    font-size: 30px;
    color: rgba(255, 255, 255, 0.85);
    width: 62px;
    -unity-text-align: middle-left;
}

/* Phase 7 B20: a cream ring round the player dot. The P4 teal is 2.73:1 against the panel ink on its own; the
   ring (cream, ~13:1 on the ink) carries the "this is a marker" edge for every player colour, so no dot depends on
   its hue alone. 38 px outer, 3 px ring, the 32 px glossy sprite inside. */
.cw-lb-dot {
    width: 38px; height: 38px; flex-shrink: 0; margin-right: 8px;
    border-left-width: 3px; border-right-width: 3px; border-top-width: 3px; border-bottom-width: 3px;
    border-left-color: rgb(254, 245, 224); border-right-color: rgb(254, 245, 224);
    border-top-color: rgb(254, 245, 224); border-bottom-color: rgb(254, 245, 224);
    border-top-left-radius: 19px; border-top-right-radius: 19px;
    border-bottom-left-radius: 19px; border-bottom-right-radius: 19px;
    background-image: url("project://database/Assets/_Game/Art/UI/Atoms/PlayerDotGlossy.png");
    -unity-background-scale-mode: scale-to-fit;
}

/* Names, not P# (Phase 4): You / DashFox / BrunoB / PeckNoir / P1-P4, <= 8 chars. 150 px fits
   "PeckNoir" at 34 px Lilita; anything longer ellipsizes instead of pushing the bar. The bar gave
   up 70 px of the 88 so the panel only grows 18 px.
   Cream, not the player colour (round-2 finding 5: player colours on this panel were 2.4-3.9:1;
   cream is ~13:1 on the panel ink). The player colour is on the dot and the bar; the local
   player's name is the gold YOU mark (YouMark.uss). */
.cw-lb-name {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/LilitaOne-Regular.ttf");
    font-size: 34px;
    color: rgb(254, 245, 224);
    width: 150px;
    -unity-text-align: middle-left;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}

/* Progress bar (food / target) */
.cw-lb-bar-trough {
    width: 120px;
    height: 15px;
    background-color: rgba(0, 0, 0, 0.6);
    border-radius: 8px;
    margin-left: 14px; margin-right: 20px;
    overflow: hidden;
}

.cw-lb-bar-fill {
    height: 100%;
    width: 0%; /* Driven by code */
    background-color: white; /* Tinted by code */
    border-radius: 8px;
}

.cw-lb-score {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/LilitaOne-Regular.ttf");
    font-size: 34px;
    color: rgb(245, 200, 66); /* Gold */
    -unity-text-align: middle-right;
    width: 76px;
}

/* Goal pill: under the timer, right-aligned, in both orientations (WP7 / decision C5). It used to hang under the
   leaderboard into the arena (CW-212). */
.cw-target-badge {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/LilitaOne-Regular.ttf");
    font-size: 32px;
    color: rgb(245, 200, 66);
    background-color: rgba(20, 14, 8, 0.85);
    padding: 7px 22px;
    margin-top: 10px;
    border-radius: 22px;
    border-width: 2px;
    border-color: rgba(245, 200, 66, 0.5);
    align-self: flex-end;
    white-space: nowrap;
}

/* ============================================================================
   RIGHT: EMBOSSED MATCH TIMER + GOAL PILL (a column, right-aligned)
   ============================================================================ */
.cw-timer-container {
    flex-direction: column;
    align-items: flex-end;
    justify-content: flex-start;
}

.cw-timer {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/LilitaOne-Regular.ttf");
    font-size: 52px; letter-spacing: 4px;
    color: rgb(254, 245, 224);
    -unity-text-align: middle-center; white-space: nowrap;
    flex-shrink: 0;
    padding-top: 9px; padding-bottom: 13px; padding-left: 38px; padding-right: 38px;
    
    /* Dark gradient background: USS doesn't have linear-gradient yet, use solid or sprite */
    background-color: rgb(24, 18, 12);
    
    /* gold border with a top-highlight / bottom-shade bevel for the emboss */
    border-left-width: 3px; border-right-width: 3px; border-top-width: 3px; border-bottom-width: 3px;
    border-top-color: rgb(245, 200, 66); border-left-color: rgb(212, 160, 32);
    border-right-color: rgb(212, 160, 32); border-bottom-color: rgb(150, 110, 20);
    border-top-left-radius: 18px; border-top-right-radius: 18px;
    border-bottom-left-radius: 18px; border-bottom-right-radius: 18px;
}

/* ============================================================================
   PORTRAIT (WP7, PORTRAIT_AND_LANDSCAPE_SPEC 1.5). MatchHudController puts
   .layout--portrait on #TopBarRoot (LayoutClasses, measured on the full panel).
   Base rules above stay the landscape look; these are overrides only.
   HudControlZones mirrors the band numbers (top band = the layout's min-height
   minus its 40 px fade, below the safe-area top); Phase8ChunkDRivalArrowTests
   parses them, so change both together.
   ============================================================================ */
/* The band sizes to its content (the safe-area top padding sits on top of it); the gradient covers it plus the fade. */
.cw-topbar.layout--portrait { height: auto; }
/* min-height = 20 top padding + the full four-row board (256) + the 40 px fade, so the band and its gradient keep the
   same size while the phone board is compact (two rows): the info zone matches what is drawn. */
.layout--portrait .cw-topbar-layout { min-height: 316px; padding-bottom: 40px; }

/* Board takes the room, capped; the timer column never gives any up. This alone removes the timer-over-score overlap (CW-206). */
.layout--portrait .cw-lb-container { flex-grow: 1; flex-shrink: 1; min-width: 0; max-width: 640px; }
.layout--portrait .cw-lb-panel { align-self: stretch; }
.layout--portrait .cw-lb-row { height: 52px; }
/* 48 px with no Label padding (the default 2 + 2 px left 40 px of content, under "2nd" / "4th" at 28 px: UiProbe U3). */
.layout--portrait .cw-lb-ord { width: 48px; padding-left: 0; padding-right: 0; font-size: 28px; flex-shrink: 0; }
.layout--portrait .cw-lb-dot {
    width: 32px; height: 32px;
    border-top-left-radius: 16px; border-top-right-radius: 16px;
    border-bottom-left-radius: 16px; border-bottom-right-radius: 16px;
}
/* The name absorbs the squeeze (ellipsis is on the base rule); the bar shrinks to a floor; the score never shrinks. */
.layout--portrait .cw-lb-name { width: auto; flex-grow: 1; flex-shrink: 1; min-width: 0; font-size: 30px; }
.layout--portrait .cw-lb-bar-trough { width: auto; flex-basis: 72px; flex-grow: 0; flex-shrink: 1; min-width: 40px; }
.layout--portrait .cw-lb-score { width: 64px; font-size: 30px; flex-shrink: 0; }

.layout--portrait .cw-timer-container { flex-shrink: 0; margin-left: 16px; }
.layout--portrait .cw-timer { font-size: 44px; padding-top: 8px; padding-bottom: 8px; padding-left: 24px; padding-right: 24px; }
.layout--portrait .cw-target-badge { font-size: 28px; padding: 6px 18px; }
