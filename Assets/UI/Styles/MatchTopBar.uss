/* ============================================================================
   Cluck Wars : match top-bar HUD (Stage 2a + Stage A UI rebuild)
   Consumed by Assets/UI/MatchTopBar.uxml + MatchHudController.cs.
   Design source: docs/ART.md 6.3 + Design CWMatchHUDv3L
   ============================================================================ */

/* ---- Full-width transparent top strip (dark to clear fade) ---------------- */
.cw-topbar {
    position: absolute; left: 0; top: 0; right: 0;
    height: 180px; /* increased to accommodate panel */
    background-image: url("project://database/Assets/_Game/Art/UI/Backgrounds/HudTopGradient.png");
    -unity-background-scale-mode: stretch-to-fill;
}

/* Intro countdown (ART.md 6.5): top bar stays visible but recedes to 40%
   opacity behind the "GET READY" overlay. Toggled by MatchHudController
   from MatchOverlaysController's intro-countdown state. */
.cw-topbar--dimmed {
    opacity: 0.4;
}

.cw-topbar-layout {
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-start;
    padding-top: 16px; padding-left: 16px; padding-right: 16px;
    width: 100%;
}

/* ============================================================================
   LEFT: RANKED LEADERBOARD PANEL + TARGET BADGE
   ============================================================================ */
.cw-lb-container {
    flex-direction: column;
    align-items: flex-start;
}

.cw-lb-panel {
    background-color: rgba(20, 14, 8, 0.85);
    border-radius: 8px;
    padding: 6px;
    /* Optional border for the whole panel */
    border-left-width: 1px; border-right-width: 1px; border-top-width: 1px; border-bottom-width: 1px;
    border-color: rgba(60, 45, 30, 0.8);
}

.cw-lb-row {
    flex-direction: row;
    align-items: center;
    height: 32px;
    padding-left: 6px; padding-right: 8px;
    margin-bottom: 4px;
    border-radius: 4px;
    border-left-width: 3px;
    border-left-color: transparent; /* Updated by controller for local player */
}

/* Faint gold wash for the leader, applied dynamically by controller if needed */
.cw-lb-row--leader {
    background-color: rgba(245, 200, 66, 0.15);
}

.cw-lb-ord {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/LilitaOne-Regular.ttf");
    font-size: 14px;
    color: rgba(255, 255, 255, 0.7);
    width: 28px;
    -unity-text-align: middle-left;
}

.cw-lb-dot {
    width: 18px; height: 18px; flex-shrink: 0; margin-right: 6px;
    background-image: url("project://database/Assets/_Game/Art/UI/Atoms/PlayerDotGlossy.png");
    -unity-background-scale-mode: scale-to-fit;
}

.cw-lb-name {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/LilitaOne-Regular.ttf");
    font-size: 16px;
    width: 26px;
    -unity-text-align: middle-left;
}

/* Progress bar (food / target) */
.cw-lb-bar-trough {
    width: 100px;
    height: 8px;
    background-color: rgba(0, 0, 0, 0.6);
    border-radius: 4px;
    margin-left: 8px; margin-right: 12px;
    overflow: hidden;
}

.cw-lb-bar-fill {
    height: 100%;
    width: 0%; /* Driven by code */
    background-color: white; /* Tinted by code */
    border-radius: 4px;
}

.cw-lb-score {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/LilitaOne-Regular.ttf");
    font-size: 18px;
    color: rgb(245, 200, 66); /* Gold */
    -unity-text-align: middle-right;
    width: 40px;
}

.cw-target-badge {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/LilitaOne-Regular.ttf");
    font-size: 14px;
    color: rgb(245, 200, 66);
    background-color: rgba(20, 14, 8, 0.85);
    padding: 4px 12px;
    margin-top: 6px;
    border-radius: 12px;
    border-width: 1px;
    border-color: rgba(245, 200, 66, 0.5);
    align-self: center;
}

/* ============================================================================
   RIGHT: EMBOSSED MATCH TIMER
   ============================================================================ */
.cw-timer-container {
    flex-direction: row;
    align-items: flex-start;
    justify-content: flex-end;
}

.cw-timer {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/LilitaOne-Regular.ttf");
    font-size: 28px; letter-spacing: 3px;
    color: rgb(254, 245, 224);
    -unity-text-align: middle-center; white-space: nowrap;
    flex-shrink: 0;
    padding-top: 5px; padding-bottom: 7px; padding-left: 22px; padding-right: 22px;
    
    /* Dark gradient background: USS doesn't have linear-gradient yet, use solid or sprite */
    background-color: rgb(24, 18, 12);
    
    /* gold border with a top-highlight / bottom-shade bevel for the emboss */
    border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px;
    border-top-color: rgb(245, 200, 66); border-left-color: rgb(212, 160, 32);
    border-right-color: rgb(212, 160, 32); border-bottom-color: rgb(150, 110, 20);
    border-top-left-radius: 10px; border-top-right-radius: 10px;
    border-bottom-left-radius: 10px; border-bottom-right-radius: 10px;
}
