/* ============================================================================
   Cluck Wars : on-screen touch controls (Stage 2b rebuild)
   Consumed by Assets/UI/TouchControls.uxml + TouchControlsController.cs.
   Design source: docs/ART.md 6.6 (hex anatomy) + 6.7 (MOBA touch layout).
   Sprites: Assets/_Game/Art/UI/  (Stage-0 export)
     Atoms/JoystickBase.png, Atoms/JoystickKnob.png  : joystick
     Atoms/HexGlossy.png  : neutral hex, tinted per-ability AccentColor at runtime
                            via -unity-background-image-tint-color
     Icons/Abilities/Icon_<Type>.png : ability icons, swapped via .cw-hex-icon--* classes
   Reference resolution 1920x1080 (shared PanelSettings ScaleWithScreenSize).
   Sizing contract: see the header of Assets/UI/Styles/CluckWarsTheme.uss.
   The HIT TARGETS here were always phone-correct (150px hex = 64 dp, joystick
   base 280px = 119 dp). The TEXT was not: the short label was 15px (6.4 sp)
   and the slot badge 20px (8.5 sp), the two smallest strings in the app. Both
   were raised 2026-07-23; anything added inside a hex must clear 26px.
   Positions mirror the shipped UGUI tunables (ART 6.7 reference table):
     A1 center (-170,170)  A2 center (-210,360)  A3 center (-410,270)
     A4 center (-390,460) from BR  (a4 is v0.7, no UGUI reference)
     joystick center (220,220) from BL, base 280, knob 128, maxRadius 108.
   USS-valid only: NO gradient / box-shadow / text-shadow / gap : depth comes
   from the baked glossy sprites + flat fills + beveled borders, exactly as the
   Stage-1/2a surfaces do. Cooldown is a bottom-up clip, never a radial fill.
   ============================================================================ */

/* ---- Full-screen transparent host (never eats input outside the controls) -- */
.cw-touch-root {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    /* no background : the 3D game shows through everywhere but the controls */
}
/* The two control clusters' zones (JoystickRoot / AbilityRoot): full-screen, transparent, never
   take a tap. TouchControlsController insets them to Screen.safeArea (SafeAreaPadding), and the
   controls are positioned inside them. */
.cw-touch-zone {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
}

/* ============================================================================
   VIRTUAL JOYSTICK  (bottom-left)
   ============================================================================ */
.cw-joy-base {
    position: absolute;
    left: 80px; bottom: 80px;
    width: 280px; height: 280px;
    background-image: url("project://database/Assets/_Game/Art/UI/Atoms/JoystickBase.png");
    -unity-background-scale-mode: scale-to-fit;
}
.cw-joy-knob {
    position: absolute;
    left: 76px; top: 76px;            /* (280-128)/2 : centered in base */
    width: 128px; height: 128px;
    background-image: url("project://database/Assets/_Game/Art/UI/Atoms/JoystickKnob.png");
    -unity-background-scale-mode: scale-to-fit;
    /* controller drives style.translate to follow the finger */
}

/* ============================================================================
   CONTROL-CONSEQUENCE MARKING ON THE STICK  (FEEDBACK.md 5.2, cases 17 / 19)
   The stick stays fully draggable in every state - ControlRules.CanMove is
   enforced in ChickenController, and a HUD that ALSO swallowed the input would
   double-gate it and hide input bugs. These classes only say what the game is
   already doing. Both overlay labels are picking-mode="Ignore" in the UXML so
   they can never intercept the thumb that is trying to steer.
   Only STRUCTURE lives here : which mark is visible, how big, where. The tint
   colours are written by TouchControlsController from FeedbackTuning
   (NeutralNoEffectColor when blocked, CanonicalSlowColor when slowed) so the
   stick speaks the same colour language as the rings on the chickens.
   ============================================================================ */
.cw-joy-glyph {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    font-size: 96px;
    -unity-text-align: middle-center;
    color: rgb(254, 245, 224);
    display: none;                    /* only the rooted state shows a glyph */
}
/* 40px = 17 dp : well clear of the 26px text floor, and it has to stay legible
   under a thumb that is mid-drag. */
.cw-joy-slow {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/LilitaOne-Regular.ttf");
    font-size: 40px; letter-spacing: 1px;
    -unity-text-align: middle-center;
    color: rgb(254, 245, 224);
    display: none;
}
/* Rooted : greyed + the shackle. Stunned : greyed, no glyph - the ability
   cluster is simultaneously wearing the red cross, which is the stronger and
   less ambiguous read for "you are stunned", and doubling it on the stick would
   just be noise. Slowed : tinted, magnitude label, NOT greyed (you can still
   move, and greying it would say otherwise). */
.cw-joy--rooted .cw-joy-glyph { display: flex; }
.cw-joy--slowed .cw-joy-slow  { display: flex; }

/* ============================================================================
   HEX ABILITY BUTTONS  (right-hand MOBA arc)
   Each hex is 150px; the controller sets -unity-background-image-tint-color on the
   inset .cw-hex-fill to the equipped ability's category colour (opaque at rest, also
   with nobody in range; dimmed while on cooldown, red-grey when stunned).
   ============================================================================ */
/* Phase 6 (A1): the .cw-hex element itself is the INK RIM - the hex sprite tinted ink (#2a1a0c), seen as a
   3 px band around the inset .cw-hex-fill that carries the category colour. Held = a bright (cream) rim.
   Scale / opacity of the held state are written inline by TouchControlsController from FeedbackTuning. */
.cw-hex {
    position: absolute;
    width: 150px; height: 150px;
    background-image: url("project://database/Assets/_Game/Art/UI/Atoms/HexGlossy.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(42, 26, 12);
    justify-content: center; align-items: center;
}
.cw-hex--held { -unity-background-image-tint-color: rgb(254, 245, 224); }
/* The coloured hex, inset 3 px so the rim shows around it. First child, so everything else paints over it. */
.cw-hex-fill {
    position: absolute;
    left: 3px; right: 3px; top: 3px; bottom: 3px;
    background-image: url("project://database/Assets/_Game/Art/UI/Atoms/HexGlossy.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(115, 179, 255); /* neutral until equipped */
}
/* MOBA arc positions (element edge offsets, measured from the AbilityRoot's bottom-right corner).
   Phase 6 chunk 6 (A11): every hex CENTRE sits on a 270 px (~115 dp at 1 dp = 2.35 px) arc around slot 1's
   centre (170,170 from the corner), 40 degrees apart, so the thumb that rests on slot 1 reaches all four
   without leaving its pivot (the old fourth slot was ~364 px / 155 dp away). Neighbours are 185 px apart
   centre to centre against a 150 px hex, so the gap between hexes is 35 px. Centres (from the corner):
     a1 (170,170)  a2 (217,436)  a3 (377,344)  a4 (440,170)
   TouchHudLayoutTests parses these four rules and fails if any centre drifts past 125 dp of slot 1, two hexes
   overlap, or one leaves the 2400x1080 / 1920x864 / 1440x1080 panels. */
.cw-hex--a1 { right: 95px;  bottom: 95px;  }   /* centre (-170,170) */
.cw-hex--a2 { right: 142px; bottom: 361px; }   /* centre (-217,436) : straight up, a touch left */
.cw-hex--a3 { right: 302px; bottom: 269px; }   /* centre (-377,344) : the diagonal */
.cw-hex--a4 { right: 365px; bottom: 95px;  }   /* centre (-440,170) : level with slot 1, to its left */

/* --- Layer 6 : cooldown clip (dark overlay rising from the bottom) --------- */
/* The wrapper's height % = remaining/total; overflow hidden crops the fill's
   top so the dark hex silhouette rises from the bottom edge upward. */
.cw-hex-cd {
    position: absolute;
    left: 3px; right: 3px; bottom: 3px;   /* inside the ink rim, like .cw-hex-fill */
    height: 0%;
    overflow: hidden;
}
.cw-hex-cd-fill {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 144px;                    /* == .cw-hex-fill height, so the silhouette aligns */
    background-image: url("project://database/Assets/_Game/Art/UI/Atoms/HexGlossy.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgba(0, 0, 0, 0.62); /* ART 6.6 layer 6 */
}

/* --- Layer 6 (again) : active-ability drain (accent band receding UPWARD) ---
   FEEDBACK.md 6, case 27 : "another ability is active". Deliberately the exact
   mirror of the cooldown clip above - anchored TOP instead of bottom, and
   accent-tinted instead of black - so "an ability is RUNNING" and "an ability
   is COOLING" are opposite in both direction and colour and can never be
   confused, even though they can legitimately be on the same hex at once (an
   ability burns its cooldown at activation, so the slot that is running is
   usually also cooling). Same clip mechanism, no new ART 6.6 layer.
   Height % = AbilityController.ActiveRemaining01; the tint is written by the
   controller from the equipped ability's AccentColor. */
.cw-hex-drain {
    position: absolute;
    left: 3px; right: 3px; top: 3px;      /* inside the ink rim, like .cw-hex-fill */
    height: 0%;
    overflow: hidden;
}
.cw-hex-drain-fill {
    position: absolute;
    left: 0; right: 0; top: 0;
    height: 144px;                    /* == .cw-hex-fill height, so the silhouette aligns */
    background-image: url("project://database/Assets/_Game/Art/UI/Atoms/HexGlossy.png");
    -unity-background-scale-mode: scale-to-fit;
    /* tint (accent, semi-transparent) written per-frame by the controller */
}

/* --- Layer 7 : ability icon (design-exported sprite, swapped per-ability) -- */
.cw-hex-icon {
    width: 88px; height: 88px;        /* the icon alone identifies the move (Phase 2 art) */
    -unity-background-scale-mode: scale-to-fit;
    /* background-image set by a .cw-hex-icon--* class at runtime */
}

/* --- Layer 7 : short label (fallback only: shown when a type has no icon) --- */
/* 2026-07-23 Android pass: was 15px = 6.4 sp, the smallest type in the app.
   The hit targets in this sheet were always fine (150px hex = 64 dp), but its
   TEXT was authored at desktop scale like the menu sheet. 28px = 12 sp is the
   ceiling here — the label has to live inside a 150px hex under a 64px icon,
   so the icon's margin-bottom grew to 26px to keep them from overlapping. */
.cw-hex-label {
    position: absolute;
    bottom: 16px; left: 0; right: 0;
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/LilitaOne-Regular.ttf");
    font-size: 28px; letter-spacing: 0.5px;
    color: rgb(254, 245, 224);
    -unity-text-align: middle-center; white-space: nowrap;
}

/* --- Layer 9 : cooldown seconds (centered, only while cd > 0) -------------- */
.cw-hex-cdnum {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/LilitaOne-Regular.ttf");
    font-size: 46px;
    color: rgb(254, 245, 224);
    /* ink outline: the number sits on top of the cream icon silhouette */
    -unity-text-outline-width: 4px;
    -unity-text-outline-color: rgb(42, 26, 12);
    -unity-text-align: middle-center;
    display: none;                    /* controller shows while cooling down */
}

/* --- Layer 9 (again) : refusal state mark, DRAWN not typed ----------------
   FEEDBACK.md 6 cases 25 (no valid target) and 26 (stunned). Layer 9
   generalises from "cooldown seconds" to "state indicator" and carries
   whichever refusal won; AbilityRefusalRules.Evaluate makes the reasons
   mutually exclusive, so the centre of the hex never has to arbitrate between
   two marks and no tenth layer is needed.
   WHY DRAWN : U+20E0 (circle-backslash) and U+2715 (multiplication X) are
   absent from BOTH LilitaOne-Regular.ttf and NotoEmoji-Regular.ttf, and
   TMP Settings ships an empty m_fallbackFontAssets - typing them would have
   drawn tofu on every platform. One-line reversible via
   HudFeedbackStyle.UseDrawnRefusalMarks.
   Colours are written by the controller from FeedbackTuning
   (NeutralNoEffectColor / RefusalStunnedCrossColor) - never baked here. */
.cw-hex-state {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
    justify-content: center; align-items: center;
    display: none;                    /* shown by the hex's refusal class */
}
/* One stroke of the stunned cross. Insets: (150-84)/2 = 33, (150-8)/2 = 71. */
.cw-hex-state-bar {
    position: absolute;
    left: 33px; top: 71px;
    width: 84px; height: 8px;
    border-top-left-radius: 4px; border-top-right-radius: 4px;
    border-bottom-left-radius: 4px; border-bottom-right-radius: 4px;
    display: none;
}
.cw-hex-state-bar--a { rotate: -45deg; }
.cw-hex-state-bar--b { rotate: 45deg; }

/* --- Refusal states (ART 6.6 layers 2-4 + 7 + 9) --------------------------
   Structure and dimming only; the fill/tint COLOUR for each state comes from
   FeedbackTuning via the controller, because 1.3 forbids relying on colour
   alone and those colours are shared with the world-space feedback. */
.cw-hex--cooldown    .cw-hex-icon { opacity: 0.35; }   /* ART 6.6 layer 9 */
.cw-hex--stunned     .cw-hex-icon { opacity: 0.50; }

/* No "no target" state (Phase 6, A1): a ready hex with nobody in range renders exactly like any ready hex -
   full category hue, icon at full opacity, nothing drawn over the glyph. The in-range pip (below) is the
   cue that someone IS in range: presence, not colour. */

/* Stunned : two crossed strokes, red, no ring - a cross, not a "forbidden"
   circle. Shape is the second channel per 1.3, so a colour-blind player still
   tells "cannot cast" from "nothing to hit" without reading the hue. */
.cw-hex--stunned .cw-hex-state            { display: flex; }
.cw-hex--stunned .cw-hex-state-bar--a     { display: flex; }
.cw-hex--stunned .cw-hex-state-bar--b     { display: flex; }

/* Stunned also suppresses the short label, so the cross has the hex to itself
   and the cluster reads as one blocked group rather than three busy buttons. */
.cw-hex--stunned .cw-hex-label            { opacity: 0.35; }

/* --- Layer 8 : slot-index badge (top-left circle) ------------------------- */
.cw-hex-badge {
    position: absolute;
    top: 14px; left: 14px;
    width: 54px; height: 54px;
    background-color: rgba(26, 14, 4, 0.95);
    border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px;
    border-top-color: rgba(255,255,255,0.25); border-left-color: rgba(255,255,255,0.15);
    border-right-color: rgba(0,0,0,0.35); border-bottom-color: rgba(0,0,0,0.45);
    border-top-left-radius: 27px; border-top-right-radius: 27px;
    border-bottom-left-radius: 27px; border-bottom-right-radius: 27px;
    justify-content: center; align-items: center;
}
.cw-hex-badge-text {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/LilitaOne-Regular.ttf");
    font-size: 34px;
    color: rgb(254, 245, 224);
    -unity-text-align: middle-center;
}

/* --- In-range pip (Phase 6, A1) ------------------------------------------
   Bottom-centre of the hex (top-left = slot badge, top-right = category mark). Gold #f5c842 with a
   3 px ink ring: 22 px of gold inside a 28 px disc (28 px = ~12 dp at this canvas's 1 dp = 2.35 px).
   Shown only while a rival is inside this move's shape and the move is not cooling down; the one 0.2 s
   scale pop is driven by TouchControlsController (and skipped under Reduced Motion). */
.cw-hex-pip {
    position: absolute;
    left: 61px; bottom: 6px;          /* (150 - 28) / 2 = 61 */
    width: 28px; height: 28px;
    background-color: rgb(245, 200, 66);
    border-left-width: 3px; border-right-width: 3px; border-top-width: 3px; border-bottom-width: 3px;
    border-left-color: rgb(42, 26, 12); border-right-color: rgb(42, 26, 12);
    border-top-color: rgb(42, 26, 12); border-bottom-color: rgb(42, 26, 12);
    border-top-left-radius: 14px; border-top-right-radius: 14px;
    border-bottom-left-radius: 14px; border-bottom-right-radius: 14px;
    display: none;
}

/* --- Active-ability duration ring (Phase 6, A1) ---------------------------
   HexDurationRing paints a hexagonal outline at radius 80 around the hex centre. The element is larger
   than the hex (170 px, offset -10) so the stroke can sit outside the hex's own 150 px box. */
.cw-hex-ring {
    position: absolute;
    left: -10px; top: -10px;
    width: 170px; height: 170px;
}

/* Peck auto-chain: HexChainRing paints a spinning dashed hexagon at radius 92 (Phase 6 chunk 4). The element
   is 190 px (offset -20) so the stroke clears the duration ring and stays inside its own box. */
.cw-hex-chain {
    position: absolute;
    left: -20px; top: -20px;
    width: 190px; height: 190px;
}

/* ============================================================================
   GLYPH FONT
   LilitaOne carries only 225 codepoints and TMP Settings' fallback list is
   empty, so any element showing a status glyph must select the project's
   tintable monochrome emoji font explicitly (the same face UiGfx.EmojiFont
   already loads for the UGUI-era labels). Confirmed present in its cmap:
   U+26A1 stun, U+26D3 root, U+1F40C slow.
   ============================================================================ */
.cw-glyph-font {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/NotoEmoji-Regular.ttf");
}

/* ============================================================================
   STATUS STRIP  (FEEDBACK.md 5.2, cases 17 / 18 / 19)
   RE-SITED, and deliberately: 5.2 says "below the cargo readout", but the cargo
   readout moved to world space on the chicken (ChickenWorldBars, ART 6.3 - "the
   game area is sacred") and no longer exists in the HUD at all. The strip now
   stacks directly ABOVE the joystick base, because the thing it explains is
   what the stick can and cannot do : the constraint and the control it
   constrains have to land in one glance.
   Geometry: joystick base is left:80 bottom:80 h:280, so its top edge is at
   bottom:360. The strip's bottom sits at 380 (20px clearance) and, having no
   fixed height, GROWS UPWARD as rows appear - one badge therefore always
   appears in the same place, right above the stick, exactly like the
   world-space badge stack is bottom-anchored above the nameplate.
   Most severe on top (stun > root > slow), matching 5.1.
   ============================================================================ */
.cw-status-strip {
    position: absolute;
    left: 80px; bottom: 380px;
    width: 380px;
}
/* Flat fill + beveled border, per this sheet's no-gradient/no-shadow contract.
   No `gap` : row separation is margin-top (the first row's margin is harmless,
   the strip is bottom-anchored and auto-height). */
.cw-status-row {
    flex-direction: row;
    align-items: center;
    height: 62px;
    margin-top: 8px;
    padding-left: 14px; padding-right: 14px;
    background-color: rgba(26, 14, 4, 0.82);
    border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px;
    border-top-color: rgba(255,255,255,0.22); border-left-color: rgba(255,255,255,0.14);
    border-right-color: rgba(0,0,0,0.35); border-bottom-color: rgba(0,0,0,0.45);
    border-top-left-radius: 10px; border-top-right-radius: 10px;
    border-bottom-left-radius: 10px; border-bottom-right-radius: 10px;
    display: none;                    /* controller shows the live rows only */
}
/* 34px = 14.5 dp. Tinted per-row by the controller to the canonical
   stun/root/slow colour, so the strip and the chicken agree on hue as well as
   on glyph. */
.cw-status-glyph {
    width: 46px;
    font-size: 34px;
    -unity-text-align: middle-center;
    color: rgb(254, 245, 224);
}
/* 28px = 12 sp, the same floor the hex short-label was raised to in the
   2026-07-23 Android pass. Nothing in this sheet goes below it. */
.cw-status-name {
    flex-grow: 1;
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/LilitaOne-Regular.ttf");
    font-size: 28px; letter-spacing: 1px;
    -unity-text-align: middle-left;
    color: rgb(254, 245, 224);
    margin-left: 8px;
}
.cw-status-value {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/LilitaOne-Regular.ttf");
    font-size: 28px;
    -unity-text-align: middle-right;
    color: rgb(254, 245, 224);
    min-width: 110px;
}
/* Draining bar along the row's bottom edge. Track and fill share one colour;
   the track is dimmed by FeedbackTuning.DrainRingTrackAlphaMultiplier from the
   controller, exactly like the world-space drain rings, so "how much is left"
   out-contrasts "how much there was" identically in both places.
   SLOW GETS NO BAR - see HudFeedbackStyle.HasDrainBar for why that would be a
   lie; the controller hides this element on the slow row. */
.cw-status-bar {
    position: absolute;
    left: 14px; right: 14px; bottom: 6px;
    height: 6px;
    border-top-left-radius: 3px; border-top-right-radius: 3px;
    border-bottom-left-radius: 3px; border-bottom-right-radius: 3px;
    overflow: hidden;
}
.cw-status-bar-fill {
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 100%;
    border-top-left-radius: 3px; border-top-right-radius: 3px;
    border-bottom-left-radius: 3px; border-bottom-right-radius: 3px;
}

/* ============================================================================
   ABILITY ICON SPRITES  (37 : type-name -> Icons/Abilities/Icon_<TypeName>.png)
   One rule per AbilityIconStyle.ByType entry, kept identical in CluckWarsTheme.uss
   and TouchControls.uss (AbilityIconArtTests checks every class, file and url).
   Cream silhouettes with an ink outline on transparent: the coloured hex / accent
   disc behind them supplies the colour (menu overhaul Phase 2).
   ============================================================================ */
.cw-hex-icon--dive-bomb    { background-image: url("project://database/Assets/_Game/Art/UI/Icons/Abilities/Icon_RollTrampleAbilitySO.png"); }
.cw-hex-icon--cluck        { background-image: url("project://database/Assets/_Game/Art/UI/Icons/Abilities/Icon_CluckShockAbilitySO.png"); }
.cw-hex-icon--snatch       { background-image: url("project://database/Assets/_Game/Art/UI/Icons/Abilities/Icon_SnatchAbilitySO.png"); }
.cw-hex-icon--peck         { background-image: url("project://database/Assets/_Game/Art/UI/Icons/Abilities/Icon_PeckAbilitySO.png"); }
.cw-hex-icon--roll         { background-image: url("project://database/Assets/_Game/Art/UI/Icons/Abilities/Icon_RollPushAbilitySO.png"); }
.cw-hex-icon--trap         { background-image: url("project://database/Assets/_Game/Art/UI/Icons/Abilities/Icon_FeatherTrapAbilitySO.png"); }
.cw-hex-icon--aura         { background-image: url("project://database/Assets/_Game/Art/UI/Icons/Abilities/Icon_FeatherAuraAbilitySO.png"); }
.cw-hex-icon--root         { background-image: url("project://database/Assets/_Game/Art/UI/Icons/Abilities/Icon_RootEggAbilitySO.png"); }
.cw-hex-icon--shell        { background-image: url("project://database/Assets/_Game/Art/UI/Icons/Abilities/Icon_EggShellAbilitySO.png"); }
.cw-hex-icon--turtle       { background-image: url("project://database/Assets/_Game/Art/UI/Icons/Abilities/Icon_TurtleModeAbilitySO.png"); }
.cw-hex-icon--spine        { background-image: url("project://database/Assets/_Game/Art/UI/Icons/Abilities/Icon_SpineCoatAbilitySO.png"); }
.cw-hex-icon--burst        { background-image: url("project://database/Assets/_Game/Art/UI/Icons/Abilities/Icon_SpeedBurstAbilitySO.png"); }
.cw-hex-icon--invis        { background-image: url("project://database/Assets/_Game/Art/UI/Icons/Abilities/Icon_InvisibilityAbilitySO.png"); }
.cw-hex-icon--doppel       { background-image: url("project://database/Assets/_Game/Art/UI/Icons/Abilities/Icon_DoppelgangerAbilitySO.png"); }
.cw-hex-icon--steal        { background-image: url("project://database/Assets/_Game/Art/UI/Icons/Abilities/Icon_SneakyStealAbilitySO.png"); }
.cw-hex-icon--ambush       { background-image: url("project://database/Assets/_Game/Art/UI/Icons/Abilities/Icon_AmbushAbilitySO.png"); }
.cw-hex-icon--wing-slam    { background-image: url("project://database/Assets/_Game/Art/UI/Icons/Abilities/Icon_WingSlamAbilitySO.png"); }
.cw-hex-icon--shadowstep   { background-image: url("project://database/Assets/_Game/Art/UI/Icons/Abilities/Icon_ShadowstepAbilitySO.png"); }
