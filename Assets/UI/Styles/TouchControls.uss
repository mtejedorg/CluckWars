/* ============================================================================
   FIZZLE + EDGE-BAND CANCEL  (Phase 6 chunk 2)
   Every element here is built in code (TouchControlsController.BuildFlashElements) or lives in the UXML
   root, is picking-mode Ignore and starts hidden. Cream bars with an ink border: shape, not just colour.
   1 dp = ~2.35 px on this canvas.
   ============================================================================ */

/* The 0.3 s slash flash after a fizzle: a transient bar across the hex, reusing the state-bar geometry
   (84 px long, centred, rotated). A single "/" so it can never be read as the stunned cross. */
.cw-hex-flash-slash {
    position: absolute;
    left: 33px; top: 69px;
    width: 84px; height: 12px;
    background-color: rgb(254, 245, 224);
    border-left-width: 3px; border-right-width: 3px; border-top-width: 3px; border-bottom-width: 3px;
    border-left-color: rgb(42, 26, 12); border-right-color: rgb(42, 26, 12);
    border-top-color: rgb(42, 26, 12); border-bottom-color: rgb(42, 26, 12);
    border-top-left-radius: 6px; border-top-right-radius: 6px;
    border-bottom-left-radius: 6px; border-bottom-right-radius: 6px;
    rotate: -45deg;
}

/* The whiff puff (Art/UI/Fx/Fx_Whiff.png): a little cloud over the hex, scaled and faded by the controller. */
.cw-hex-puff {
    position: absolute;
    left: -20px; top: -20px;
    width: 190px; height: 190px;
    background-image: url("project://database/Assets/_Game/Art/UI/Fx/Fx_Whiff.png");
    -unity-background-scale-mode: scale-to-fit;
}

/* The cancel X shown over the held hex while the edge band is armed: two crossed bars, bigger than the
   stunned cross's weight class so it reads as a different thing. */
.cw-hex-x {
    position: absolute;
    left: 0; right: 0; top: 0; bottom: 0;
}
.cw-hex-x-bar {
    position: absolute;
    left: 28px; top: 69px;
    width: 94px; height: 12px;
    background-color: rgb(254, 245, 224);
    border-left-width: 3px; border-right-width: 3px; border-top-width: 3px; border-bottom-width: 3px;
    border-left-color: rgb(42, 26, 12); border-right-color: rgb(42, 26, 12);
    border-top-color: rgb(42, 26, 12); border-bottom-color: rgb(42, 26, 12);
    border-top-left-radius: 6px; border-top-right-radius: 6px;
    border-bottom-left-radius: 6px; border-bottom-right-radius: 6px;
}
.cw-hex-x-bar--a { rotate: -45deg; }
.cw-hex-x-bar--b { rotate: 45deg; }

/* The edge glow strips: ~4 dp wide (10 px), cream at 85% with a 3 px ink line on the inner side, along ONE
   physical screen edge at a time. Hidden until a held finger arms the cancel. */
.cw-edge-glow {
    position: absolute;
    background-color: rgba(254, 245, 224, 0.85);
    display: none;
}
.cw-edge-glow--left, .cw-edge-glow--right { top: 0; bottom: 0; width: 13px; }
.cw-edge-glow--top, .cw-edge-glow--bottom { left: 0; right: 0; height: 13px; }
.cw-edge-glow--left   { left: 0;   border-right-width:  3px; border-right-color:  rgb(42, 26, 12); }
.cw-edge-glow--right  { right: 0;  border-left-width:   3px; border-left-color:   rgb(42, 26, 12); }
.cw-edge-glow--top    { top: 0;    border-bottom-width: 3px; border-bottom-color: rgb(42, 26, 12); }
.cw-edge-glow--bottom { bottom: 0; border-top-width:    3px; border-top-color:    rgb(42, 26, 12); }

/* ============================================================================
   DESKTOP / CONTROLLER LAYOUT  (Phase 6 chunk 6, A10)
   TouchControlsController puts .cw-hud--desktop (keyboard + mouse) or .cw-hud--pad (gamepad) on #TouchRoot while
   that is the last-used device, and takes it off the moment a finger touches the screen. The joystick goes; the
   hexes become an INFORMATION strip at the bottom centre (picking-mode Ignore, scale 0.75 written by the
   controller), left to right in slot order, each badged with the key or button that fires it.
   Strip geometry: 4 hexes, 136 px pitch, centred on the screen: left edges at -279 / -143 / -7 / +129 from centre.
   ============================================================================ */
.cw-hud--desktop .cw-joy-base, .cw-hud--pad .cw-joy-base { display: none; }
.cw-hud--desktop .cw-status-strip, .cw-hud--pad .cw-status-strip { left: 40px; bottom: 60px; }

.cw-hud--desktop .cw-hex--a1, .cw-hud--pad .cw-hex--a1 { left: 50%; right: auto; bottom: 4px; margin-left: -279px; }
.cw-hud--desktop .cw-hex--a2, .cw-hud--pad .cw-hex--a2 { left: 50%; right: auto; bottom: 4px; margin-left: -143px; }
.cw-hud--desktop .cw-hex--a3, .cw-hud--pad .cw-hex--a3 { left: 50%; right: auto; bottom: 4px; margin-left: -7px; }
.cw-hud--desktop .cw-hex--a4, .cw-hud--pad .cw-hex--a4 { left: 50%; right: auto; bottom: 4px; margin-left: 129px; }

/* Badge: a key cap. 40 px text x the strip's 0.75 scale = 30 px on screen (floor 28); cream on near-black ink is
   far above 4.5:1. A two-letter pad label (RB / LT) widens the cap into a pill. */
.cw-hud--desktop .cw-hex-badge, .cw-hud--pad .cw-hex-badge {
    width: auto; min-width: 54px;
    padding-left: 10px; padding-right: 10px;
}
.cw-hud--desktop .cw-hex-badge-text, .cw-hud--pad .cw-hex-badge-text { font-size: 40px; }

/* ============================================================================
   FIRST-TIME HOLD HINT  (Phase 6 chunk 6, A1)
   One line above the ability cluster while a hex is held, for the first five real holds. The host is full width
   and click-through; the label is the plate. Right-aligned over the thumb arc on touch, centred over the strip on
   desktop / pad. 32 px text (floor 28). The fade is a plain opacity transition; the controller zeroes it under
   Reduced Motion.
   ============================================================================ */
.cw-hold-hint-host {
    position: absolute;
    left: 0; right: 0; bottom: 560px;
    align-items: flex-end;
    padding-right: 40px;
}
.cw-hud--desktop .cw-hold-hint-host, .cw-hud--pad .cw-hold-hint-host {
    bottom: 160px; align-items: center; padding-right: 0;
}
.cw-hold-hint {
    max-width: 880px;
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/Nunito-Bold.ttf");
    font-size: 32px;
    color: rgb(254, 245, 224);
    -unity-text-align: middle-center;
    white-space: normal;
    padding-top: 10px; padding-bottom: 10px; padding-left: 22px; padding-right: 22px;
    background-color: rgba(26, 14, 4, 0.9);
    border-left-width: 3px; border-right-width: 3px; border-top-width: 3px; border-bottom-width: 3px;
    border-left-color: rgb(42, 26, 12); border-right-color: rgb(42, 26, 12);
    border-top-color: rgb(42, 26, 12); border-bottom-color: rgb(42, 26, 12);
    border-top-left-radius: 14px; border-top-right-radius: 14px;
    border-bottom-left-radius: 14px; border-bottom-right-radius: 14px;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.25s;
}
.cw-hold-hint--on { opacity: 1; }
