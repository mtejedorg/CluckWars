/* ============================================================================
   Cluck Wars — in-match overlays
   Consumed by Assets/UI/MatchOverlays.uxml + MatchOverlaysController.cs.
   Sprites: Assets/_Game/Art/UI/  (tintable atoms are neutral white/grey →
   tinted in C# via -unity-background-image-tint-color).
   Palette: ink #2a1a0c, cream #fef5e0 / #fff8e8, gold #f5c842, wood #8a5a2e —
   the same values as CluckWarsTheme.uss (written out literally: this sheet is
   attached to its own UIDocument and does not load the menu theme).

   Display type (Lilita One on art, wood or a coloured face: ribbons, buttons,
   board headings, the countdown digit) carries an ink -unity-text-outline plus a
   hard text-shadow, exactly like the menus. Both render on Unity 6000.3 (verified
   in the menu theme on 2026-10-06). Still NOT available: box-shadow, gap,
   linear-gradient — depth comes from the painted frames (Frame_WoodPanel,
   Frame_Ribbon, Frame_CtaPlank, Card_Cream 9-slices).

   Phase 4 (2026-10-07): the post-match screen is rebuilt on THE COOP's visual
   system — barn backdrop (Bg_Lobby), a 2nd/1st/3rd podium of Pedestal_Ring
   steps, wood ribbon banner, a wood standings board of cream row cards. Player
   colour appears only on the dots, bars, pedestal rings and plate stripes; every
   name and class line is ink-on-cream or cream-on-ink.

   2026-07-23 Android pass: 1 dp ~= 2.35 px on this canvas, so body copy never
   goes below 30-34 px and every touch target is >= 116 px (48 dp).
   ============================================================================ */

/* ---- Overlay scaffolding -------------------------------------------------- */
.cw-overlay-host {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
}
.cw-overlay {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    align-items: center; justify-content: center;
}
.cw-overlay--dim      { background-color: rgba(8, 4, 2, 0.94); }   /* --cw-overlay-bg */
/* Match end is opaque: at 0.88-0.97 the arena and touch HUD still read through around the panel. */
.cw-overlay--opaque   { background-color: rgb(8, 4, 2); }
.cw-overlay--introdim { background-color: rgba(0, 0, 0, 0.45); }

/* LEAVE MATCH? sheet (Phase 6 chunk 7b): a dark scrim over the frozen arena and the touch HUD, one wood panel. */
.cw-leave-sheet { background-color: rgba(20, 10, 4, 0.82); }
.cw-leave-panel {
    width: 1000px; max-width: 94%;
    padding-top: 36px; padding-bottom: 40px; padding-left: 48px; padding-right: 48px;
    align-items: stretch;
}
.cw-leave-body {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/LilitaOne-Regular.ttf");
    font-size: 44px; letter-spacing: 1px; color: rgb(254, 245, 224);
    -unity-text-align: middle-center; white-space: normal;
    margin-top: 36px; margin-bottom: 40px; padding-left: 0; padding-right: 0;
    -unity-text-outline-width: 3px; -unity-text-outline-color: rgb(42, 26, 12);
}
.cw-leave-actions { flex-direction: row; justify-content: center; }
.cw-leave-btn { flex-grow: 1; flex-basis: 0; min-height: 132px; margin-left: 12px; margin-right: 12px; }

/* ============================================================================
   MATCH END  (podium on the barn)
   ============================================================================ */
/* Winner celebration (Phase 3B, MatchCelebration): cream and gold feathers + gold sparkles from
   Art/UI/Fx drift down the podium column, behind its banner / chickens / labels (first child of
   #MeHero, clipped to it, so never over any text), never taking a tap; none under Reduced Motion.
   The .cw-fx-* particle classes are the same as in CluckWarsTheme.uss (separate sheet). */
.cw-celebration { position: absolute; left: 0; top: 0; right: 0; bottom: 0; overflow: hidden; }
.cw-fx-live.cw-fx-live { transition-duration: 0s; }
.cw-fx-particle {
    position: absolute; left: 0; top: 0;
    -unity-background-scale-mode: scale-to-fit;
}
.cw-fx-sparkle {
    width: 56px; height: 56px; margin-left: -28px; margin-top: -28px;
    background-image: url("project://database/Assets/_Game/Art/UI/Fx/Fx_Sparkle.png");
    -unity-background-image-tint-color: rgb(255, 214, 80);
}
.cw-fx-dust {
    width: 100px; height: 100px; margin-left: -50px; margin-top: -50px;
    background-image: url("project://database/Assets/_Game/Art/UI/Fx/Fx_Dust.png");
    -unity-background-image-tint-color: rgb(255, 248, 232);
}
.cw-fx-feather-1, .cw-fx-feather-2, .cw-fx-feather-3 {
    width: 64px; height: 64px; margin-left: -32px; margin-top: -32px;
    -unity-background-image-tint-color: rgb(255, 248, 232);
}
.cw-fx-feather-1 { background-image: url("project://database/Assets/_Game/Art/UI/Fx/Fx_Feather_1.png"); }
.cw-fx-feather-2 { background-image: url("project://database/Assets/_Game/Art/UI/Fx/Fx_Feather_2.png"); }
.cw-fx-feather-3 { background-image: url("project://database/Assets/_Game/Art/UI/Fx/Fx_Feather_3.png"); }
/* Two-tone feather (round 2, finding 17): the particle itself is the warm rim (tinted amber in C#); this
   child is the same sprite in cream, a little smaller, laid over it, so only a thin warm edge shows. */
.cw-fx-feather__body {
    position: absolute; left: 0; top: 0; margin-left: 0; margin-top: 0;
    scale: 0.86 0.86;
}

/* Backdrop: THE COOP's barn gate (Bg_Lobby, 2880x1440, centred 16:9 safe area), scale-and-crop so
   4:3 and 20:9 keep the centre; an ink vignette + light scrim over it, as on the menu pages. */
.cw-me-backdrop {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    background-image: url("project://database/Assets/_Game/Art/UI/Backgrounds/Bg_Lobby.png");
    -unity-background-scale-mode: scale-and-crop;
}
.cw-me-backdrop-tint {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(26, 13, 4, 0.22);
    background-image: url("project://database/Assets/_Game/Art/UI/Atoms/Vignette.png");
    -unity-background-scale-mode: stretch-to-fill;
}
/* Safe-area host: MatchOverlaysController pads it from Screen.safeArea (SafeAreaPadding). */
.cw-me-safe {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    align-items: stretch; justify-content: center;
}
.cw-me-panel {
    flex-grow: 1; flex-direction: row; align-items: stretch;
    padding-top: 26px; padding-bottom: 26px; padding-left: 36px; padding-right: 36px;
}

/* -- Left: banner + podium -- */
.cw-me-hero {
    flex-grow: 1.2; flex-basis: 0; min-width: 0;
    align-items: center; justify-content: flex-start;
    margin-right: 28px;
}

/* Wood ribbon (Frames/Frame_Ribbon, 768x160, horizontal 3-slice 168/0/168/0): fixed height so the
   swallowtails scale uniformly and only the plank stretches; the plank's text band is y 15-121 of
   160, so the label sits above centre (more padding at the bottom). Same art as the menu titles. */
.cw-me-ribbon {
    background-image: url("project://database/Assets/_Game/Art/UI/Frames/Frame_Ribbon.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 168; -unity-slice-right: 168; -unity-slice-top: 0; -unity-slice-bottom: 0;
    -unity-slice-scale: 0.65px;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    height: 104px; min-width: 420px; flex-shrink: 0;
    padding-top: 0; padding-bottom: 20px; padding-left: 124px; padding-right: 124px;
    align-items: center; justify-content: center;
}
/* The win banner is the screen's title: one step bigger (0.75 = 120/160). */
.cw-me-ribbon--win {
    -unity-slice-scale: 0.75px; height: 120px; min-width: 520px;
    padding-bottom: 24px; padding-left: 128px; padding-right: 128px;   /* just past the 126 px tails: fits the 4:3 hero column */
}
.cw-me-ribbon--win .cw-me-ribbon__label { font-size: 60px; }
/* Gold-warmed wood (THE COOP's READY! banner). */
.cw-me-ribbon--gold    { -unity-background-image-tint-color: rgb(255, 226, 150); }
.cw-me-ribbon__label {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/LilitaOne-Regular.ttf");
    font-size: 52px; letter-spacing: 3px; color: rgb(254, 245, 224);
    -unity-text-align: middle-center; white-space: nowrap;
    -unity-text-outline-width: 5px; -unity-text-outline-color: rgb(42, 26, 12);
    text-shadow: 0px 4px 0px rgba(42, 26, 12, 0.85);
    padding-top: 0; padding-bottom: 0; margin-top: 0; margin-bottom: 0;
}
/* Draw (nobody banked): no podium, so the banner + "No winner this round." sit centred in the column. */
.cw-me-hero--draw { justify-content: center; }
/* "You · 2nd" (round 2, finding 6): the YOU mark's gold pill (YouMark.uss), one step bigger, under the sub. */
.cw-me-youchip {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/LilitaOne-Regular.ttf");
    font-size: 34px; letter-spacing: 2px; white-space: nowrap; -unity-text-align: middle-center;
    margin-top: 10px; flex-shrink: 0;
}
/* Winner's class under the banner: cream on an ink plate (it sits on the bright barn art). */
.cw-me-winsub {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/LilitaOne-Regular.ttf");
    font-size: 36px; letter-spacing: 3px; color: rgb(254, 245, 224);
    -unity-text-align: middle-center; white-space: nowrap;
    background-color: rgba(42, 26, 12, 0.78);
    border-top-left-radius: 14px; border-top-right-radius: 14px;
    border-bottom-left-radius: 14px; border-bottom-right-radius: 14px;
    padding-left: 22px; padding-right: 22px; padding-top: 2px; padding-bottom: 6px;
    margin-top: 6px; flex-shrink: 0;
}

/* Podium: three steps side by side, all as tall as the column; inside each, the plates line up at
   the bottom and the block height is the placing, so the chickens stand at three heights. */
.cw-me-podium {
    flex-grow: 1; min-height: 0; align-self: stretch;
    flex-direction: row; align-items: stretch; justify-content: center;
    margin-top: 10px;
}
.cw-me-pod {
    flex-grow: 1; flex-basis: 0; min-width: 0; max-width: 360px;
    margin-left: 10px; margin-right: 10px;
    justify-content: flex-end; align-items: stretch;
}
/* A step with nobody on it leaves the layout: 2 birds = two steps centred (round 2, finding 6). */
.cw-me-pod--hidden { display: none; }
.cw-me-pod__stage { flex-grow: 1; min-height: 150px; align-items: center; justify-content: flex-end; }
/* Frames/Pedestal_Ring (512x128, white art) tinted with the player colour in C#; drawn before the
   chicken so its feet stand on it, overlapping the block's top edge. */
.cw-me-pod__ring {
    position: absolute; bottom: -22px;
    width: 88%; height: 70px;
    background-image: url("project://database/Assets/_Game/Art/UI/Frames/Pedestal_Ring.png");
    -unity-background-scale-mode: scale-to-fit;
}
/* The render is square and the element is not: contain + bottom keeps the feet on the ring at any
   aspect (centred, a tall element left the chicken floating above it on 4:3). */
/* Every bird is drawn at one common size and the crowned one at 1.25x (PodiumLayout.ChickenScales sets
   a USS scale per step from the bottom centre: the feet stay on the ring, nothing re-lays out). */
.cw-me-pod__chicken {
    width: 96%; flex-grow: 1; max-height: 280px; margin-bottom: 10px;
    transform-origin: 50% 100%;
    background-size: contain; background-repeat: no-repeat;
    background-position-x: center; background-position-y: bottom;
    /* static figure via a .cw-chicken--<class> modifier set in C#; live texture painted over it */
}
/* Headroom over the centre step for the 1.25x winner and its crown. */
.cw-me-pod--1 .cw-me-pod__chicken { margin-top: 110px; }
/* Crown in the icon style (Icons/Podium/Crown_Gold: gold, ink outline, cream gems). left / top are set
   every frame in C# from the head anchor (MatchOverlaysController.PlaceCrown, PodiumLayout.CrownTopLeft). */
.cw-me-crown {
    position: absolute; top: 0; left: 0;
    width: 96px; height: 96px;
    background-image: url("project://database/Assets/_Game/Art/UI/Icons/Podium/Crown_Gold.png");
    -unity-background-scale-mode: scale-to-fit;
    rotate: -8deg;
}
.cw-me-winglow {
    position: absolute; bottom: 0; left: -10%; right: -10%; height: 110%;
    background-image: url("project://database/Assets/_Game/Art/UI/Atoms/RadialGlow.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgba(255, 214, 80, 0.55);
}
/* Wood step (Frames/Frame_WoodPanel 9-slice). 1st > 2nd > 3rd: MatchStandingsTests pins the order. */
.cw-me-pod__block {
    flex-shrink: 0; align-items: center; justify-content: center;
    background-image: url("project://database/Assets/_Game/Art/UI/Frames/Frame_WoodPanel.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 40; -unity-slice-right: 40; -unity-slice-top: 40; -unity-slice-bottom: 40;
    -unity-slice-scale: 0.6px;
    margin-left: 6px; margin-right: 6px;
}
/* Height = the SHARED place (tier set in C# from MatchStandings.Places), so tied birds stand level. */
.cw-me-pod--tier-1 .cw-me-pod__block { height: 170px; }
.cw-me-pod--tier-2 .cw-me-pod__block { height: 118px; }
.cw-me-pod--tier-3 .cw-me-pod__block { height: 82px; }
.cw-me-pod__block .cw-me-medal { width: 72px; height: 72px; margin-right: 0; padding-top: 10px; }
/* Cream nameplate, like THE COOP's seats: ink outline, player-colour top stripe (C#). */
.cw-me-pod__plate {
    flex-shrink: 0; align-items: center;
    margin-top: 8px;
    padding-top: 6px; padding-bottom: 10px; padding-left: 12px; padding-right: 12px;
    background-color: rgb(255, 248, 232);
    border-left-width: 4px; border-right-width: 4px; border-top-width: 10px; border-bottom-width: 4px;
    border-left-color: rgb(42, 26, 12); border-right-color: rgb(42, 26, 12);
    border-top-color: rgb(42, 26, 12); border-bottom-color: rgb(42, 26, 12);
    border-top-left-radius: 18px; border-top-right-radius: 18px;
    border-bottom-left-radius: 18px; border-bottom-right-radius: 18px;
}
.cw-me-pod__name {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/LilitaOne-Regular.ttf");
    font-size: 38px; color: rgb(42, 26, 12); -unity-text-align: middle-center;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%;
    padding-top: 0; padding-bottom: 0; margin-top: 0; margin-bottom: 0;
}
.cw-me-pod__foodrow { flex-direction: row; align-items: center; justify-content: center; }
.cw-me-pod__foodicon {
    width: 34px; height: 34px; margin-right: 8px;
    background-image: url("project://database/Assets/_Game/Art/UI/Icons/FoodIcon.png");
    -unity-background-scale-mode: scale-to-fit;
}
.cw-me-pod__score {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/LilitaOne-Regular.ttf");
    font-size: 40px; color: rgb(42, 26, 12); padding-top: 0; padding-bottom: 0;
}
/* Draw (EMPTY NESTS!, round-3 finding 14): the same pods, but all four birds on level ground under the banner - no
   wood steps, medals, scores or winner headroom. Declared after the --1 headroom rule so it wins the tie. */
.cw-me-podium--draw .cw-me-pod__block,
.cw-me-podium--draw .cw-me-pod__foodrow { display: none; }
.cw-me-podium--draw .cw-me-pod__chicken { margin-top: 0; }
.cw-me-podium--draw .cw-me-pod__ring { bottom: -4px; }
.cw-me-podium--draw .cw-me-pod { margin-left: 4px; margin-right: 4px; }
.cw-me-podium--draw .cw-me-pod__name { font-size: 30px; }   /* four plates share the column: "PeckNoir" must not ellipsise on 4:3 */

/* -- Right: the standings board (Frames/Frame_WoodPanel 9-slice) -- */
/* Sized to its rows (round 2, finding 6): centred in the panel's height instead of stretched, so 2 rows
   are a short board, not a tall one that is mostly empty wood. */
.cw-me-right {
    flex-grow: 1; flex-basis: 0; min-width: 800px; max-width: 980px;   /* 4:3 floor: rows + KO + both buttons fit */
    align-self: center;
    background-image: url("project://database/Assets/_Game/Art/UI/Frames/Frame_WoodPanel.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 40; -unity-slice-right: 40; -unity-slice-top: 40; -unity-slice-bottom: 40;
    -unity-slice-scale: 1px;
    padding-top: 40px; padding-bottom: 36px; padding-left: 44px; padding-right: 44px;
}
.cw-me-head { flex-direction: row; align-items: center; flex-shrink: 0; }
.cw-me-head__title {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/LilitaOne-Regular.ttf");
    font-size: 46px; letter-spacing: 2px; color: rgb(254, 245, 224); margin-right: 16px;
    -unity-text-outline-width: 4px; -unity-text-outline-color: rgb(42, 26, 12);
    text-shadow: 0px 4px 0px rgba(42, 26, 12, 0.85);
    padding-top: 0; padding-bottom: 0;
}
.cw-me-head__rule { flex-grow: 1; height: 4px; background-color: rgba(42, 26, 12, 0.55); border-top-left-radius: 2px; border-top-right-radius: 2px; border-bottom-left-radius: 2px; border-bottom-right-radius: 2px; }
/* GOAL 40 · REACHED / TIME'S UP: cream with a thin ink outline on the wood (body text on art). */
.cw-me-head__note {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/LilitaOne-Regular.ttf");
    font-size: 32px; letter-spacing: 2px; color: rgb(255, 226, 150);
    -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(42, 26, 12);
    text-shadow: 0px 3px 0px rgba(42, 26, 12, 0.8);
    margin-top: 4px; margin-bottom: 14px; flex-shrink: 0;
}
.cw-me-rows { flex-grow: 0; flex-shrink: 0; }

/* Row cards built in C#: Frames/Card_Cream 9-slice (outline + bevel baked in, so no element border);
   the winner's row swaps to Card_CreamSelected (same geometry, gold inner edge: no layout shift). */
.cw-me-row {
    flex-direction: row; align-items: center;
    padding-top: 12px; padding-bottom: 14px; padding-left: 20px; padding-right: 24px;
    margin-bottom: 6px;
    background-image: url("project://database/Assets/_Game/Art/UI/Frames/Card_Cream.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 40; -unity-slice-right: 40; -unity-slice-top: 40; -unity-slice-bottom: 44;
    -unity-slice-scale: 0.75px;
    background-color: rgba(0, 0, 0, 0);
}
.cw-me-row--winner { background-image: url("project://database/Assets/_Game/Art/UI/Frames/Card_CreamSelected.png"); }
/* Placement medal in the icon style (Icons/Podium/Medal_*: ink outline, gold / silver / bronze /
   plain cream face) with the place number on the disc. The disc sits low in its 256 px canvas
   (centre y 150), so the number gets more padding on top. */
.cw-me-medal {
    width: 60px; height: 60px; flex-shrink: 0; margin-right: 14px;
    -unity-background-scale-mode: scale-to-fit;
    align-items: center; justify-content: center;
    padding-top: 8px;
    background-image: url("project://database/Assets/_Game/Art/UI/Icons/Podium/Medal_Plain.png");
}
.cw-me-medal--1 { background-image: url("project://database/Assets/_Game/Art/UI/Icons/Podium/Medal_Gold.png"); }
.cw-me-medal--2 { background-image: url("project://database/Assets/_Game/Art/UI/Icons/Podium/Medal_Silver.png"); }
.cw-me-medal--3 { background-image: url("project://database/Assets/_Game/Art/UI/Icons/Podium/Medal_Bronze.png"); }
.cw-me-medal__num {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/LilitaOne-Regular.ttf");
    font-size: 30px; color: rgb(42, 26, 12); -unity-text-align: middle-center;
    padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 0; margin-left: 0; margin-right: 0;
}
.cw-me-pod__block .cw-me-medal__num { font-size: 36px; }
.cw-me-dot {
    width: 40px; height: 40px; flex-shrink: 0; margin-right: 14px;
    background-image: url("project://database/Assets/_Game/Art/UI/Atoms/PlayerDotGlossy.png");
    -unity-background-scale-mode: scale-to-fit;
    /* tint set in C# to player color */
}
/* Name on top, "CLASS [CPU]" under it: the tag no longer eats the name's width (4:3 cut "DashFox"). */
.cw-me-rowmid { width: 250px; flex-shrink: 0; margin-right: 14px; }
.cw-me-rowclassrow { flex-direction: row; align-items: center; }
.cw-me-rowname {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/LilitaOne-Regular.ttf");
    font-size: 36px; color: rgb(42, 26, 12); white-space: nowrap;
    overflow: hidden; text-overflow: ellipsis; flex-shrink: 1; min-width: 0;
    padding-top: 0; padding-bottom: 0; padding-left: 0;
}
/* CPU tag: THE COOP's seat tag (cream inset, ink outline, ink text). */
.cw-me-rowtag {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/Nunito-Bold.ttf");
    font-size: 28px; color: rgb(42, 26, 12); flex-shrink: 0; margin-left: 10px;
    background-color: rgb(243, 230, 200);
    border-left-width: 3px; border-right-width: 3px; border-top-width: 3px; border-bottom-width: 3px;
    border-left-color: rgb(42, 26, 12); border-right-color: rgb(42, 26, 12);
    border-top-color: rgb(42, 26, 12); border-bottom-color: rgb(42, 26, 12);
    padding-top: 0; padding-bottom: 0; padding-left: 8px; padding-right: 8px;
    border-top-left-radius: 8px; border-top-right-radius: 8px;
    border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;
}
/* Class line: warm brown on cream (~7:1). Never the player colour (re-audit finding 2). */
.cw-me-rowpn {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/Nunito-Bold.ttf");
    font-size: 30px; letter-spacing: 1px; color: rgb(107, 74, 42); white-space: nowrap;
    padding-top: 0; padding-bottom: 0; padding-left: 0; margin-top: 0;
}
.cw-me-bartrough {
    flex-grow: 1; height: 18px; min-width: 40px; margin-left: 4px; margin-right: 18px;
    background-color: rgba(42, 26, 12, 0.18);
    overflow: hidden;
    border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px;
    border-left-color: rgba(42, 26, 12, 0.6); border-right-color: rgba(42, 26, 12, 0.6);
    border-top-color: rgba(42, 26, 12, 0.6); border-bottom-color: rgba(42, 26, 12, 0.6);
    border-top-left-radius: 9px; border-top-right-radius: 9px;
    border-bottom-left-radius: 9px; border-bottom-right-radius: 9px;
}
.cw-me-barfill {
    height: 100%; width: 0;
    background-image: url("project://database/Assets/_Game/Art/UI/Atoms/BarFill.png");
    -unity-background-scale-mode: stretch-to-fill;
    /* width % + tint set in C# to player color */
}
.cw-me-rowfood { flex-direction: row; align-items: center; flex-shrink: 0; }
.cw-me-rowfoodicon {
    width: 32px; height: 32px; margin-right: 6px;
    background-image: url("project://database/Assets/_Game/Art/UI/Icons/FoodIcon.png");
    -unity-background-scale-mode: scale-to-fit;
}
.cw-me-rowscore {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/LilitaOne-Regular.ttf");
    font-size: 38px; color: rgb(42, 26, 12); min-width: 64px; -unity-text-align: middle-right;
    padding-top: 0; padding-bottom: 0;
}
/* KO column: only shown once someone has a knockout (MatchStandings.ShowKoColumn). */
.cw-me-rowstats {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/Nunito-Bold.ttf");
    font-size: 30px; color: rgb(107, 74, 42); min-width: 80px; -unity-text-align: middle-right;
    white-space: nowrap; margin-left: 12px; flex-shrink: 0;
}
.cw-me-rows--no-ko .cw-me-rowstats { display: none; }

/* Post-match actions: PLAY AGAIN (green) + BACK TO LOBBY (wood), side by side. */
.cw-me-actions { flex-direction: row; justify-content: center; margin-top: 14px; flex-shrink: 0; }
.cw-me-action { flex-grow: 1; flex-basis: 0; margin-left: 10px; margin-right: 10px; letter-spacing: 2px; padding-left: 20px; padding-right: 20px; }
.cw-me-restart {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/Nunito-Bold.ttf");
    font-size: 30px; letter-spacing: 1px; color: rgb(254, 245, 224);
    -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(42, 26, 12);
    text-shadow: 0px 3px 0px rgba(42, 26, 12, 0.8);
    -unity-text-align: middle-center; margin-top: 12px; min-height: 40px;
    flex-shrink: 0;
}

/* Class figures — 1024 px renders of the real models (Hero_<cls>_idle.png, shared with the menus),
   applied with a .cw-chicken--<class> modifier in C# on the podium chickens and the lobby cards.
   The winner gets the "cheer" render (Flare clip, head back, chest out). */
.cw-chicken--warrior  { background-image: url("project://database/Assets/_Game/Art/UI/Chickens/Hero_warrior_idle.png"); }
.cw-chicken--speedy   { background-image: url("project://database/Assets/_Game/Art/UI/Chickens/Hero_speedy_idle.png"); }
.cw-chicken--fatty    { background-image: url("project://database/Assets/_Game/Art/UI/Chickens/Hero_fatty_idle.png"); }
.cw-chicken--assassin { background-image: url("project://database/Assets/_Game/Art/UI/Chickens/Hero_assassin_idle.png"); }
.cw-me-pod--1 .cw-chicken--warrior  { background-image: url("project://database/Assets/_Game/Art/UI/Chickens/Hero_warrior_cheer.png"); }
.cw-me-pod--1 .cw-chicken--speedy   { background-image: url("project://database/Assets/_Game/Art/UI/Chickens/Hero_speedy_cheer.png"); }
.cw-me-pod--1 .cw-chicken--fatty    { background-image: url("project://database/Assets/_Game/Art/UI/Chickens/Hero_fatty_cheer.png"); }
.cw-me-pod--1 .cw-chicken--assassin { background-image: url("project://database/Assets/_Game/Art/UI/Chickens/Hero_assassin_cheer.png"); }

/* ============================================================================
   IN-MATCH WAITING ROOM  (multiplayer only; round 2, finding 2)
   ============================================================================ */
/* The room is THE COOP: Assets/UI/MatchOverlays.uxml attaches CluckWarsTheme.uss to #LobbyOverlay
   alone, so its seats, rule chips, bottom bar and planks are the menu's own classes (.cw-seat*,
   .cw-rule-chips, .cw-coop-*, .cw-btn, .cw-home-btn). Only the layout glue lives here. */
/* Safe-area host (SafeAreaPadding pads it), laid out like a menu page: header / chips / lineup / bar. */
.cw-wr-safe {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    flex-direction: column; align-items: stretch; justify-content: flex-start;
}
/* Host / guest line under the action planks: one line of body copy with the on-art outline. (In the
   bar's centre column it collapsed to one letter per line next to a long invite card.) */
.cw-wr-hint {
    -unity-text-align: middle-center; white-space: nowrap; color: rgb(254, 245, 224);
    position: absolute; right: 0; top: 100%; margin-top: 6px;
    background-color: rgba(42, 26, 12, 0.9);   /* ink plate: cream on ink ~15:1 over any barn patch */
    padding-top: 2px; padding-bottom: 4px; padding-left: 22px; padding-right: 22px;
    border-top-left-radius: 24px; border-top-right-radius: 24px;
    border-bottom-left-radius: 24px; border-bottom-right-radius: 24px;
}
/* The status pill keeps its size next to the invite card (it shrank, cutting "Waiting…" and squashing the
   lamp to a line). Id-qualified, so it outranks the scoped menu theme. */
#LobbyOverlay .cw-status-pill, #LobbyOverlay .cw-status-dot { flex-shrink: 0; }
.cw-wr-actions { flex-direction: row; align-items: center; }
/* Phone and 4:3 tablet (.layout--short / .layout--narrow): slimmer planks and SHARE / COPY, so a long invite code keeps one row instead of wrapping. */
#LobbyOverlay.layout--short .cw-wr-changebird, #LobbyOverlay.layout--narrow .cw-wr-changebird { min-width: 220px; margin-right: 12px; padding-left: 24px; padding-right: 24px; }
#LobbyOverlay.layout--short .cw-page-cta, #LobbyOverlay.layout--narrow .cw-page-cta { min-width: 380px; }
#LobbyOverlay.layout--short .cw-lobby-btnrow .cw-mini-btn, #LobbyOverlay.layout--narrow .cw-lobby-btnrow .cw-mini-btn { min-width: 116px; margin-left: 6px; padding-left: 8px; padding-right: 8px; }
#LobbyOverlay.layout--short .cw-coop-left .cw-lobby-card, #LobbyOverlay.layout--narrow .cw-coop-left .cw-lobby-card { margin-left: 8px; padding-left: 12px; padding-right: 12px; }
.cw-wr-changebird { margin-right: 18px; min-width: 300px; }

/* ---- Shared buttons — the menus' cw-btn (CluckWarsTheme.uss), restated for this sheet -------- */
.cw-btn {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/LilitaOne-Regular.ttf");
    min-height: 116px; min-width: 116px;   /* 48 dp touch floor */
    background-color: rgba(0, 0, 0, 0);   /* clear the default runtime-Button grey */
    font-size: 40px; color: rgb(254, 245, 224); -unity-text-align: middle-center;
    -unity-text-outline-width: 4px; -unity-text-outline-color: rgb(42, 26, 12);
    text-shadow: 0px 5px 0px rgba(42, 26, 12, 0.85);
    background-image: url("project://database/Assets/_Game/Art/UI/Atoms/ButtonGrayscale.png");
    -unity-background-scale-mode: stretch-to-fill;
    border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0;
    border-top-left-radius: 19px; border-top-right-radius: 19px;
    border-bottom-left-radius: 19px; border-bottom-right-radius: 19px;
    padding-top: 20px; padding-bottom: 26px; padding-left: 44px; padding-right: 44px;
    transition-property: scale; transition-duration: 0.1s;
}
.cw-btn:hover  { scale: 1.03 1.03; }
.cw-btn:active { scale: 0.97 0.97; }
/* Same painted art as the menus - green CTA plank, wood plank panel. */
.cw-btn--green {
    background-image: url("project://database/Assets/_Game/Art/UI/Frames/Frame_CtaPlank.png");
    -unity-slice-left: 48; -unity-slice-right: 48; -unity-slice-top: 36; -unity-slice-bottom: 40;
    -unity-slice-scale: 1px;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-left-radius: 0; border-bottom-right-radius: 0;
    /* the plank's 3D lip is at the bottom, so the label sits a little high */
    padding-top: 18px; padding-bottom: 28px;
}
.cw-btn--wood {
    background-image: url("project://database/Assets/_Game/Art/UI/Frames/Frame_WoodPanel.png");
    -unity-slice-left: 40; -unity-slice-right: 40; -unity-slice-top: 40; -unity-slice-bottom: 40;
    -unity-slice-scale: 0.6px;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-left-radius: 0; border-bottom-right-radius: 0;
}
/* A disabled button must still read as text: dim the face, keep the outlined label. */
.cw-btn:disabled { opacity: 1; -unity-background-image-tint-color: rgb(150, 140, 128); color: rgb(236, 226, 206); }
.cw-btn:focus {
    border-left-width: 5px; border-right-width: 5px; border-top-width: 5px; border-bottom-width: 5px;
    border-left-color: rgb(254, 245, 224); border-right-color: rgb(254, 245, 224);
    border-top-color: rgb(254, 245, 224); border-bottom-color: rgb(254, 245, 224);
}

/* ============================================================================
   SESSION END  (small panel)
   ============================================================================ */
.cw-se-panel {
    width: 1178px; max-width: 88%;
    align-items: stretch; justify-content: center;
    padding-top: 40px; padding-bottom: 36px; padding-left: 57px; padding-right: 57px;
}
.cw-se-reason {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/Nunito-Bold.ttf");
    font-size: 36px; color: rgb(254, 245, 224); -unity-text-align: middle-center; white-space: normal; margin-top: 28px;
    -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(42, 26, 12);
}
.cw-se-panel .cw-ribbon { align-self: center; min-width: 640px; }
.cw-se-btn { align-self: center; min-width: 560px; margin-top: 28px; }
.cw-se-countdown {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/Nunito-Bold.ttf");
    font-size: 30px; color: rgb(254, 245, 224); -unity-text-align: middle-center; margin-top: 14px;
    -unity-text-outline-width: 2px; -unity-text-outline-color: rgb(42, 26, 12);
}

/* ============================================================================
   INTRO COUNTDOWN  (topmost, non-interactive)
   ============================================================================ */
/* Digit + glow ride ~20% of the screen above centre: the follow camera keeps the player's own
   chicken near screen centre, and the 342 px digit used to sit right on top of it (re-audit 12). */
.cw-intro-stack {
    top: -20%;
    align-items: center; justify-content: center;
}
.cw-intro-glow {
    position: absolute; width: 1064px; height: 1064px;
    background-image: url("project://database/Assets/_Game/Art/UI/Atoms/RadialGlow.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(245, 200, 66, 0.5);
}
/* 6 px ink outline + a hard drop, like the menus' display type: the gold digit stays readable over
   any patch of arena. */
.cw-intro-number {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/LilitaOne-Regular.ttf");
    font-size: 342px; color: rgb(245, 200, 66); -unity-text-align: middle-center;
    -unity-text-outline-width: 6px; -unity-text-outline-color: rgb(42, 26, 12);
    text-shadow: 0px 12px 0px rgba(42, 26, 12, 0.9);
}
/* GET READY inside the intro overlay is the shared card (Styles/GetReadyCard.uss). */

/* Comeback / event banner (round-3 finding 5): the wood plaque of the menus (Frame_WoodPanel), lower third between
   the joystick and the ability hexes. 760 x ~150 on the 1920x1080 reference, as the ink plate it replaces. */
.cw-eventbanner {
    position: absolute; left: 0; right: 0; bottom: 150px;
    align-items: center;
}
.cw-eventbanner__plaque {
    width: 760px; max-width: 94%; align-items: center; justify-content: center;
    padding-top: 12px; padding-bottom: 20px; padding-left: 36px; padding-right: 36px;
    background-image: url("project://database/Assets/_Game/Art/UI/Frames/Frame_WoodPanel.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 40; -unity-slice-right: 40; -unity-slice-top: 40; -unity-slice-bottom: 40;
    -unity-slice-scale: 0.7px;
}
.cw-eventbanner__header {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/LilitaOne-Regular.ttf");
    font-size: 36px; letter-spacing: 2px; color: rgb(255, 214, 80); -unity-text-align: middle-center; white-space: nowrap;
    -unity-text-outline-width: 4px; -unity-text-outline-color: rgb(42, 26, 12);
    padding-top: 0; padding-bottom: 0; margin-top: 0; margin-bottom: 0;
}
.cw-eventbanner__text {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/LilitaOne-Regular.ttf");
    font-size: 52px; letter-spacing: 1px; color: rgb(254, 245, 224); -unity-text-align: middle-center; white-space: nowrap;
    -unity-text-outline-width: 5px; -unity-text-outline-color: rgb(42, 26, 12);
    text-shadow: 0px 4px 0px rgba(42, 26, 12, 0.85);
    padding-top: 0; padding-bottom: 0; margin-top: 0; margin-bottom: 0;
}

/* Host-left notice: a wood plaque in the upper third, over the arena / lobby. */
.cw-hostleft {
    position: absolute; left: 0; right: 0; top: 18%;
    align-items: center;
}
.cw-hostleft__label {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/LilitaOne-Regular.ttf");
    font-size: 56px; letter-spacing: 2px; color: rgb(254, 245, 224); -unity-text-align: middle-center;
    -unity-text-outline-width: 4px; -unity-text-outline-color: rgb(42, 26, 12);
    background-image: url("project://database/Assets/_Game/Art/UI/Frames/Frame_WoodPanel.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-slice-left: 40; -unity-slice-right: 40; -unity-slice-top: 40; -unity-slice-bottom: 40;
    -unity-slice-scale: 0.7px;
    padding-top: 18px; padding-bottom: 26px; padding-left: 64px; padding-right: 64px;
}
