/* ============================================================================
   Cluck Wars — in-match overlays (Stage 1 rebuild)
   Consumed by Assets/UI/MatchOverlays.uxml + MatchOverlaysController.cs.
   Design source: Design/cluckwars-overlays-v3.jsx (CWMatchEndV3L, CWLobbyV3L)
                  Design/cluckwars-screens-v2.jsx  (CWIntroCountdown)
   Sprites: Assets/_Game/Art/UI/  (Stage-0 export; tintable atoms are neutral
   gray → tinted in C# via -unity-background-image-tint-color).
   Palette values mirror Assets/UI/Styles/CluckWarsTokens.uss (--cw-*).
   USS-valid only: NO text-shadow / box-shadow / gap / linear-gradient — depth
   comes from baked sprite gloss + flat fills, matching CluckWarsTheme.uss.

   2026-07-23 Android pass: every px length below was scaled 1.9x (border
   widths 1.7x). The font floor was first set at 26px on a "glanceable HUD"
   rationale, then corrected to 34px (14 sp) the same day: these are
   full-screen modals the player STOPS and READS (final standings, lobby
   settings, session-end reason), i.e. body copy. Only a handful of true
   eyebrow labels and transient countdowns sit at 30px. See the mobile sizing
   contract at the top of CluckWarsTheme.uss — on this 1920x1080 canvas
   1 dp ~= 2.35 px, so the original 8-18 px type rendered at 3-8 sp on a
   phone. Panels are % width with a px max-width cap, so the caps scaled too
   and now clamp against the % rule instead of the pixel value.
   ============================================================================ */

/* ---- Overlay scaffolding -------------------------------------------------- */
.cw-overlay-host {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
}
.cw-overlay {
    position: absolute; left: 0; top: 0; right: 0; bottom: 0;
    align-items: center; justify-content: center;
}
.cw-overlay--dim      { background-color: rgba(8, 4, 2, 0.94); }   /* --cw-overlay-bg */
/* Match end is opaque: at 0.88-0.97 the arena and touch HUD still read through around the panel. */
.cw-overlay--opaque   { background-color: rgb(8, 4, 2); }
.cw-overlay--introdim { background-color: rgba(0, 0, 0, 0.45); }
.cw-flex-spacer { flex-grow: 1; }

/* ============================================================================
   MATCH END  (landscape hero + standings)
   ============================================================================ */
/* Hidden (Phase 2 review): on the opaque scrim these faint gold dots read as dark smudges
   (one sits top-centre). Phase 3 replaces them with the Fx sparkle/feather sprites. */
.cw-bg-particle {
    display: none;
    position: absolute;
    width: 46px; height: 46px;
    background-image: url("project://database/Assets/_Game/Art/UI/Atoms/PlayerDotGlossy.png");
    -unity-background-image-tint-color: rgba(245, 200, 66, 0.15);
    -unity-background-scale-mode: scale-to-fit;
}
.cw-bg-particle--1 { left: 10%; top: 20%; scale: 0.8 0.8; opacity: 0.8; }
.cw-bg-particle--2 { right: 15%; top: 15%; scale: 1.2 1.2; opacity: 0.6; }
.cw-bg-particle--3 { left: 25%; bottom: 25%; scale: 0.6 0.6; opacity: 0.7; }
.cw-bg-particle--4 { right: 20%; bottom: 30%; scale: 1.5 1.5; opacity: 0.4; }
.cw-bg-particle--5 { left: 50%; top: 10%; scale: 0.9 0.9; opacity: 0.5; }
.cw-bg-particle--6 { left: 70%; bottom: 15%; scale: 1.1 1.1; opacity: 0.9; }

.cw-me-panel {
    width: 94%; max-width: 2242px; max-height: 94%;
    flex-direction: row; align-items: stretch;
    /* padding clears the PanelFrame trim (~60px inset) on every side, so FINAL STANDINGS, the
       target note and the KO column never touch it (they did at 2424x1080 and 2048x1536). */
    padding-top: 64px; padding-bottom: 52px; padding-left: 64px; padding-right: 72px;
    background-color: rgb(42, 26, 12);
    background-image: url("project://database/Assets/_Game/Art/UI/Atoms/PanelFrame.png");
    -unity-background-scale-mode: stretch-to-fill;
    border-top-left-radius: 30px; border-top-right-radius: 30px;
    border-bottom-left-radius: 30px; border-bottom-right-radius: 30px;
}

/* -- Left hero -- */
.cw-me-hero {
    width: 570px; flex-shrink: 0;
    align-items: center; justify-content: center;
    padding-top: 11px; padding-bottom: 11px; padding-left: 15px; padding-right: 15px;
}
.cw-me-crown {
    width: 87px; height: 87px; margin-bottom: 8px;
    background-image: url("project://database/Assets/_Game/Art/UI/Icons/Crown.png");
    -unity-background-scale-mode: scale-to-fit;
}
.cw-me-ribbon {
    min-width: 399px;
    align-items: center; justify-content: center;
    padding-top: 17px; padding-bottom: 21px; padding-left: 57px; padding-right: 57px;
    background-image: url("project://database/Assets/_Game/Art/UI/Atoms/Ribbon.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgb(232, 117, 26);  /* default P1; C# sets winner color */
}
.cw-me-ribbon--gold    { -unity-background-image-tint-color: rgb(212, 160, 32); min-width: 380px; }
.cw-me-ribbon--subdued { -unity-background-image-tint-color: rgb(74, 48, 24); }
.cw-me-ribbon__label {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/LilitaOne-Regular.ttf");
    font-size: 49px; letter-spacing: 4px; color: rgb(254, 245, 224);
    -unity-text-align: middle-center; white-space: nowrap;
}

.cw-me-chickenwrap {
    width: 228px; height: 228px; margin-top: 11px;
    align-items: center; justify-content: center;
}
.cw-me-winglow {
    position: absolute; width: 285px; height: 285px;
    background-image: url("project://database/Assets/_Game/Art/UI/Atoms/RadialGlow.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(232, 117, 26, 0.45);  /* C# → winner color */
}
.cw-me-winchicken {
    width: 182px; height: 182px;
    -unity-background-scale-mode: scale-to-fit;
    /* class figure set in C# via a .cw-chicken--<class> modifier */
}

/* Class figures — 1024 px renders of the real models (Hero_<cls>_idle.png, shared with the
   menus). Applied by adding a .cw-chicken--<class> modifier in C# to the
   win-screen hero art + the per-player leaderboard rows. Retired UiGfx.Chicken(). */
.cw-chicken--warrior  { background-image: url("project://database/Assets/_Game/Art/UI/Chickens/Hero_warrior_idle.png"); }
.cw-chicken--speedy   { background-image: url("project://database/Assets/_Game/Art/UI/Chickens/Hero_speedy_idle.png"); }
.cw-chicken--fatty    { background-image: url("project://database/Assets/_Game/Art/UI/Chickens/Hero_fatty_idle.png"); }
.cw-chicken--assassin { background-image: url("project://database/Assets/_Game/Art/UI/Chickens/Hero_assassin_idle.png"); }
/* Phase 2: the winner gets the "cheer" render (Flare clip, head back, chest out). */
.cw-me-winchicken.cw-chicken--warrior  { background-image: url("project://database/Assets/_Game/Art/UI/Chickens/Hero_warrior_cheer.png"); }
.cw-me-winchicken.cw-chicken--speedy   { background-image: url("project://database/Assets/_Game/Art/UI/Chickens/Hero_speedy_cheer.png"); }
.cw-me-winchicken.cw-chicken--fatty    { background-image: url("project://database/Assets/_Game/Art/UI/Chickens/Hero_fatty_cheer.png"); }
.cw-me-winchicken.cw-chicken--assassin { background-image: url("project://database/Assets/_Game/Art/UI/Chickens/Hero_assassin_cheer.png"); }
.cw-me-rosette {
    position: absolute; right: -6px; top: -4px;
    width: 92px; height: 92px;
    background-image: url("project://database/Assets/_Game/Art/UI/Frames/Badge_Rosette.png");
    -unity-background-scale-mode: scale-to-fit;
    rotate: 12deg;
    /* tint = winner colour, set in C# */
}
/* Phase 2: the winner stands on the same tinted ring as the lobby seats (Frames/Pedestal_Ring,
   white art, tinted with the winner colour in C#); listed before the chicken in the UXML so the
   feet stand on it. */
.cw-me-winring {
    position: absolute; bottom: 0;
    width: 190px; height: 48px;
    background-image: url("project://database/Assets/_Game/Art/UI/Frames/Pedestal_Ring.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(232, 117, 26);  /* C# → winner color */
}
.cw-me-winname {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/LilitaOne-Regular.ttf");
    font-size: 42px; letter-spacing: 2px; color: rgb(254, 245, 224);
    -unity-text-align: middle-center; white-space: nowrap; margin-top: 11px;
}
.cw-me-winsub {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/Nunito-Bold.ttf");
    font-size: 30px; letter-spacing: 2px; color: rgb(232, 117, 26);  /* C# → winner color */
    -unity-text-align: middle-center; white-space: nowrap; margin-top: 2px;
}
.cw-me-winfoodrow { flex-direction: row; align-items: center; margin-top: 15px; }
.cw-me-foodicon {
    width: 38px; height: 38px; margin-right: 11px;
    background-image: url("project://database/Assets/_Game/Art/UI/Icons/FoodIcon.png");
    -unity-background-scale-mode: scale-to-fit;
}
.cw-me-winscore {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/LilitaOne-Regular.ttf");
    font-size: 65px; letter-spacing: 2px; color: rgb(245, 200, 66);
    -unity-text-align: middle-center;
}
.cw-me-winscore__unit {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/Nunito-Bold.ttf");
    font-size: 30px; color: rgb(196, 160, 96); margin-left: 10px; margin-bottom: 6px;
    -unity-text-align: lower-left;
}

.cw-me-divider {
    width: 2px; flex-shrink: 0; margin-top: 27px; margin-bottom: 27px;
    margin-left: 11px; margin-right: 23px;
    background-color: rgba(138, 106, 58, 0.4);
}

/* -- Right standings -- */
.cw-me-right { flex-grow: 1; min-width: 0; }
.cw-me-head { flex-direction: row; align-items: center; margin-bottom: 12px; flex-shrink: 0; }
.cw-me-head__title {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/LilitaOne-Regular.ttf");
    font-size: 34px; letter-spacing: 2px; color: rgb(245, 200, 66); margin-right: 15px;
}
.cw-me-head__rule { flex-grow: 1; height: 2px; background-color: rgba(245, 200, 66, 0.4); }
.cw-me-head__note {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/Nunito-Bold.ttf");
    font-size: 30px; color: rgb(196, 160, 96); margin-left: 15px;
}
/* Content-sized, NOT flex-grow. With flex-grow the rows expanded to fill the
   column and pushed "Next match in Ns…" onto the panel's bottom border, which
   is exactly what happened once the rows got taller at the 34px floor. Sizing
   to content lets the restart line follow the last row with its own margin. */
.cw-me-rows { flex-grow: 0; flex-shrink: 0; }

/* rows built in C# */
.cw-me-row {
    flex-direction: row; align-items: center;
    padding-top: 3px; padding-bottom: 3px; padding-left: 19px; padding-right: 19px;
    margin-bottom: 7px;
    background-color: rgb(48, 32, 18);
    border-left-width: 3px; border-right-width: 3px; border-top-width: 3px; border-bottom-width: 3px;
    border-left-color: rgb(58, 40, 22); border-right-color: rgb(58, 40, 22);
    border-top-color: rgb(58, 40, 22); border-bottom-color: rgb(58, 40, 22);
    border-top-left-radius: 17px; border-top-right-radius: 17px;
    border-bottom-left-radius: 17px; border-bottom-right-radius: 17px;
}
/* .cw-me-row--winner: border/tint set in C# to winner color */
.cw-me-medal {
    width: 53px; height: 53px; flex-shrink: 0; margin-right: 17px;
    -unity-background-scale-mode: scale-to-fit;
    /* rank sprite applied via cw-me-medal--1/2/3 from C#; 4th uses cw-me-dot */
}
.cw-me-medal--1 { background-image: url("project://database/Assets/_Game/Art/UI/Icons/Medal_1.png"); }
.cw-me-medal--2 { background-image: url("project://database/Assets/_Game/Art/UI/Icons/Medal_2.png"); }
.cw-me-medal--3 { background-image: url("project://database/Assets/_Game/Art/UI/Icons/Medal_3.png"); }
/* 4th place and below: a plain ink number badge in the medal slot (same footprint). */
.cw-me-place {
    align-items: center; justify-content: center;
    width: 48px; height: 48px; margin-left: 2px; margin-right: 20px;
    background-color: rgb(26, 14, 4);
    border-left-width: 3px; border-right-width: 3px; border-top-width: 3px; border-bottom-width: 3px;
    border-left-color: rgb(138, 106, 58); border-right-color: rgb(138, 106, 58);
    border-top-color: rgb(138, 106, 58); border-bottom-color: rgb(138, 106, 58);
    border-top-left-radius: 24px; border-top-right-radius: 24px;
    border-bottom-left-radius: 24px; border-bottom-right-radius: 24px;
}
.cw-me-place__num {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/LilitaOne-Regular.ttf");
    font-size: 30px; color: rgb(254, 245, 224); -unity-text-align: middle-center;
    padding-left: 0; padding-right: 0; padding-top: 0; padding-bottom: 2px; margin-left: 0; margin-right: 0;
}
.cw-me-dot {
    width: 49px; height: 49px; flex-shrink: 0; margin-right: 17px;
    background-image: url("project://database/Assets/_Game/Art/UI/Atoms/PlayerDotGlossy.png");
    -unity-background-scale-mode: scale-to-fit;
    /* tint set in C# to player color */
}
/* Width follows the longest class name at the new 34px type — "ASSASSIN" in
   Nunito-Bold is ~152px, so the old 133px clipped it (nowrap, so it truncated
   rather than wrapped). */
.cw-me-rowmid { width: 200px; flex-shrink: 0; margin-right: 15px; }
.cw-me-rowname {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/LilitaOne-Regular.ttf");
    font-size: 34px; color: rgb(254, 245, 224); white-space: nowrap;
}
.cw-me-rowpn {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/Nunito-Bold.ttf");
    font-size: 34px; letter-spacing: 1px; margin-top: 2px; white-space: nowrap;
    /* color set in C# to player color */
}
.cw-me-bartrough {
    flex-grow: 1; height: 17px; min-width: 0; margin-left: 8px; margin-right: 19px;
    background-image: url("project://database/Assets/_Game/Art/UI/Atoms/BarTrough.png");
    -unity-background-scale-mode: stretch-to-fill;
    overflow: hidden;
    border-top-left-radius: 8px; border-top-right-radius: 8px;
    border-bottom-left-radius: 8px; border-bottom-right-radius: 8px;
}
.cw-me-barfill {
    height: 100%; width: 0;
    background-image: url("project://database/Assets/_Game/Art/UI/Atoms/BarFill.png");
    -unity-background-scale-mode: stretch-to-fill;
    /* width % + tint set in C# to player color */
}
.cw-me-rowfood { flex-direction: row; align-items: center; flex-shrink: 0; }
.cw-me-rowfoodicon {
    width: 25px; height: 25px; margin-right: 8px;
    background-image: url("project://database/Assets/_Game/Art/UI/Icons/FoodIcon.png");
    -unity-background-scale-mode: scale-to-fit;
}
.cw-me-rowscore {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/LilitaOne-Regular.ttf");
    font-size: 34px; color: rgb(254, 245, 224); width: 76px; -unity-text-align: middle-right;
}
.cw-me-rowstats {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/Nunito-Bold.ttf");
    font-size: 34px; color: rgb(196, 160, 96); min-width: 120px; -unity-text-align: middle-right;
    white-space: nowrap; margin-left: 15px; flex-shrink: 0;
}
/* Post-match actions: PLAY AGAIN (green) + BACK TO LOBBY (wood), side by side. */
/* margin-bottom keeps the buttons off the PanelFrame's painted bottom rail (~40 px of trim
   inside the 30 px panel padding); they used to sit flush on it. */
.cw-me-actions { flex-direction: row; justify-content: center; margin-top: 18px; margin-bottom: 30px; flex-shrink: 0; }
.cw-me-action { flex-grow: 1; flex-basis: 0; margin-left: 12px; margin-right: 12px; letter-spacing: 2px; }
.cw-me-restart {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/Nunito-Bold.ttf");
    font-size: 34px; letter-spacing: 2px; color: rgb(196, 160, 96);
    -unity-text-align: middle-center; margin-top: 18px; min-height: 44px;
    flex-shrink: 0;
}

/* ============================================================================
   MATCH LOBBY  (rail + 2×2 grid) — same visual language as menu lobby
   ============================================================================ */
.cw-lob-panel {
    width: 96%; max-width: 2432px; max-height: 92%; flex-grow: 0;
    flex-direction: row; align-items: stretch;
    background-color: rgb(42, 26, 12);
    background-image: url("project://database/Assets/_Game/Art/UI/Atoms/PanelFrame.png");
    -unity-background-scale-mode: stretch-to-fill;
    border-top-left-radius: 30px; border-top-right-radius: 30px;
    border-bottom-left-radius: 30px; border-bottom-right-radius: 30px;
}
.cw-lob-rail {
    width: 570px; flex-shrink: 0;
    padding-top: 27px; padding-bottom: 27px; padding-left: 30px; padding-right: 30px;
    border-right-width: 2px; border-right-color: rgba(138, 106, 58, 0.4);
}
.cw-lob-card {
    margin-top: 17px;
    padding-top: 17px; padding-bottom: 17px; padding-left: 21px; padding-right: 21px;
    background-color: rgb(46, 30, 18);
    border-left-width: 3px; border-right-width: 3px; border-top-width: 3px; border-bottom-width: 3px;
    border-left-color: rgb(106, 74, 40); border-right-color: rgb(106, 74, 40);
    border-top-color: rgb(106, 74, 40); border-bottom-color: rgb(106, 74, 40);
    border-top-left-radius: 19px; border-top-right-radius: 19px;
    border-bottom-left-radius: 19px; border-bottom-right-radius: 19px;
}
.cw-lob-card__label {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/Nunito-Bold.ttf");
    font-size: 30px; letter-spacing: 2px; color: rgb(196, 160, 96);
}
.cw-lob-card__head {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/LilitaOne-Regular.ttf");
    font-size: 34px; letter-spacing: 2px; color: rgb(245, 200, 66); margin-bottom: 8px;
}
.cw-code-tiles { flex-direction: row; flex-wrap: wrap; margin-top: 11px; }
.cw-code-tile {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/LilitaOne-Regular.ttf");
    font-size: 42px; color: rgb(26, 14, 4); -unity-text-align: middle-center;
    background-image: url("project://database/Assets/_Game/Art/UI/Atoms/CodeTile.png");
    -unity-background-scale-mode: stretch-to-fill;
    min-width: 57px;
    padding-top: 4px; padding-bottom: 4px; padding-left: 15px; padding-right: 15px;
    margin-right: 8px; margin-bottom: 8px;
}
.cw-lob-btnrow { flex-direction: row; margin-top: 15px; }
.cw-mini-btn {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/LilitaOne-Regular.ttf");
    flex-grow: 1; flex-basis: 0; min-height: 116px;   /* 48 dp touch floor */
    font-size: 34px; letter-spacing: 2px; color: rgb(254, 245, 224);
    -unity-text-align: middle-center;
    background-color: rgb(58, 40, 22);
    background-image: url("project://database/Assets/_Game/Art/UI/Atoms/ButtonGrayscale.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgb(58, 40, 22);
    border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0;
    border-top-left-radius: 11px; border-top-right-radius: 11px;
    border-bottom-left-radius: 11px; border-bottom-right-radius: 11px;
    padding-top: 10px; padding-bottom: 10px;
    margin-right: 11px;
}
.cw-mini-btn--gold {
    color: rgb(26, 14, 4);
    -unity-background-image-tint-color: rgb(212, 160, 32);
}
.cw-setting-row { flex-direction: row; justify-content: space-between; margin-top: 6px; }
.cw-setting-k {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/Nunito-Bold.ttf");
    font-size: 34px; letter-spacing: 1px; color: rgb(196, 160, 96);
}
.cw-setting-v {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/Nunito-Bold.ttf");
    font-size: 34px; color: rgb(254, 245, 224);
}
.cw-status-pill {
    flex-direction: row; align-items: center; margin-top: 19px;
    padding-top: 11px; padding-bottom: 11px; padding-left: 19px; padding-right: 19px;
    background-color: rgba(245, 200, 66, 0.06);
    border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px;
    border-left-color: rgba(245, 200, 66, 0.25); border-right-color: rgba(245, 200, 66, 0.25);
    border-top-color: rgba(245, 200, 66, 0.25); border-bottom-color: rgba(245, 200, 66, 0.25);
    border-top-left-radius: 11px; border-top-right-radius: 11px;
    border-bottom-left-radius: 11px; border-bottom-right-radius: 11px;
}
.cw-status-dot {
    width: 17px; height: 17px; margin-right: 15px;
    border-top-left-radius: 10px; border-top-right-radius: 10px;
    border-bottom-left-radius: 10px; border-bottom-right-radius: 10px;
    background-color: rgb(245, 200, 66);
}
.cw-status-count {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/Nunito-Bold.ttf");
    font-size: 34px; color: rgb(254, 245, 224); margin-right: 11px;
}
.cw-status-text {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/Nunito-Bold.ttf");
    font-size: 34px; color: rgb(245, 200, 66); flex-grow: 1; -unity-text-align: middle-right;
}
.cw-lob-start { letter-spacing: 4px; margin-top: 15px; }
.cw-lob-hint {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/Nunito-Bold.ttf");
    font-size: 34px; color: rgb(196, 160, 96); -unity-text-align: middle-center;
    white-space: normal; margin-top: 11px; min-height: 27px;
}
.cw-lob-right {
    flex-grow: 1; min-width: 0;
    padding-top: 27px; padding-bottom: 27px; padding-left: 30px; padding-right: 30px;
}
.cw-players-head { flex-direction: row; align-items: center; margin-bottom: 15px; }
.cw-players-title {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/LilitaOne-Regular.ttf");
    font-size: 34px; letter-spacing: 2px; color: rgb(245, 200, 66); margin-right: 15px;
}
.cw-players-divider { flex-grow: 1; height: 2px; background-color: rgba(245, 200, 66, 0.4); }
.cw-player-grid {
    flex-grow: 1; flex-direction: row; flex-wrap: wrap;
    justify-content: space-between; align-content: space-between;
}

/* -- player cards (built in C#) -- */
.cw-player-card {
    width: 49%; height: 48%;
    flex-direction: row; align-items: center;
    padding-top: 15px; padding-bottom: 15px; padding-left: 19px; padding-right: 19px;
    background-color: rgb(48, 32, 18);
    border-left-width: 3px; border-right-width: 3px; border-top-width: 3px; border-bottom-width: 3px;
    border-left-color: rgb(106, 74, 40); border-right-color: rgb(106, 74, 40);
    border-top-color: rgb(106, 74, 40); border-bottom-color: rgb(106, 74, 40);
    border-top-left-radius: 19px; border-top-right-radius: 19px;
    border-bottom-left-radius: 19px; border-bottom-right-radius: 19px;
    overflow: hidden;
}
.cw-player-card--empty {
    background-color: rgba(20, 14, 8, 0.3);
    align-items: center; justify-content: center;
    border-left-color: rgba(138, 106, 58, 0.55); border-right-color: rgba(138, 106, 58, 0.55);
    border-top-color: rgba(138, 106, 58, 0.55); border-bottom-color: rgba(138, 106, 58, 0.55);
}
.cw-player-accent { position: absolute; left: 0; top: 0; bottom: 0; width: 8px; }
.cw-player-art {
    width: 99px; height: 99px; flex-shrink: 0; margin-right: 17px;
    -unity-background-scale-mode: scale-to-fit;
}
.cw-player-mid { flex-grow: 1; min-width: 0; }
.cw-player-namerow { flex-direction: row; align-items: center; }
.cw-player-name {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/LilitaOne-Regular.ttf");
    font-size: 34px; color: rgb(254, 245, 224); white-space: nowrap; margin-right: 10px;
}
.cw-player-pn {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/Nunito-Bold.ttf");
    font-size: 34px; margin-right: 10px;
}
.cw-player-host {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/Nunito-Bold.ttf");
    font-size: 34px; letter-spacing: 1px; color: rgb(26, 14, 4);
    background-color: rgb(245, 200, 66);
    padding-top: 2px; padding-bottom: 2px; padding-left: 10px; padding-right: 10px;
    border-top-left-radius: 6px; border-top-right-radius: 6px;
    border-bottom-left-radius: 6px; border-bottom-right-radius: 6px;
}
.cw-player-class {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/Nunito-Bold.ttf");
    font-size: 34px; color: rgb(196, 160, 96); white-space: nowrap; margin-top: 4px;
}
.cw-player-chips { flex-direction: row; margin-top: 10px; }
.cw-mini-hex {
    width: 46px; height: 53px; margin-right: 8px;
    background-image: url("project://database/Assets/_Game/Art/UI/Atoms/HexGlossy.png");
    -unity-background-scale-mode: scale-to-fit;
    align-items: center; justify-content: center;
}
.cw-mini-hex--empty { -unity-background-image-tint-color: rgba(60, 44, 26, 0.8); }
.cw-mini-hex__icon {
    width: 30px; height: 30px; -unity-background-scale-mode: scale-to-fit;
}
.cw-player-state {
    flex-shrink: 0; margin-left: 11px;
    padding-top: 8px; padding-bottom: 8px; padding-left: 17px; padding-right: 17px;
    -unity-text-align: middle-center;
    border-top-left-radius: 11px; border-top-right-radius: 11px;
    border-bottom-left-radius: 11px; border-bottom-right-radius: 11px;
}
.cw-player-state--ready {
    background-color: rgb(51, 163, 50);
    border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px;
    border-left-color: rgb(74, 230, 106); border-right-color: rgb(74, 230, 106);
    border-top-color: rgb(74, 230, 106); border-bottom-color: rgb(74, 230, 106);
}
.cw-player-state--picking {
    background-color: rgba(40, 30, 20, 0.6);
    border-left-width: 2px; border-right-width: 2px; border-top-width: 2px; border-bottom-width: 2px;
    border-left-color: rgb(138, 106, 58); border-right-color: rgb(138, 106, 58);
    border-top-color: rgb(138, 106, 58); border-bottom-color: rgb(138, 106, 58);
}
.cw-player-state__label {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/LilitaOne-Regular.ttf");
    font-size: 34px; letter-spacing: 1px; color: rgb(254, 245, 224);
}
.cw-player-empty-label {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/Nunito-Bold.ttf");
    font-size: 34px; letter-spacing: 2px; color: rgb(196, 160, 96);
}

/* ---- Shared buttons (green start) ----------------------------------------- */
.cw-btn {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/LilitaOne-Regular.ttf");
    min-height: 116px; min-width: 116px;   /* 48 dp touch floor */
    background-color: rgba(0, 0, 0, 0);   /* clear the default runtime-Button grey */
    font-size: 34px; color: rgb(254, 245, 224); -unity-text-align: middle-center;
    background-image: url("project://database/Assets/_Game/Art/UI/Atoms/ButtonGrayscale.png");
    -unity-background-scale-mode: stretch-to-fill;
    border-left-width: 0; border-right-width: 0; border-top-width: 0; border-bottom-width: 0;
    border-top-left-radius: 19px; border-top-right-radius: 19px;
    border-bottom-left-radius: 19px; border-bottom-right-radius: 19px;
    padding-top: 23px; padding-bottom: 23px; padding-left: 42px; padding-right: 42px;
    transition-property: scale; transition-duration: 0.1s;
}
.cw-btn:hover  { scale: 1.02 1.02; }
.cw-btn:active { scale: 0.97 0.97; }
/* Phase 2: same painted art as the menus - green CTA plank, wood plank panel (see CluckWarsTheme.uss). */
.cw-btn--green {
    background-image: url("project://database/Assets/_Game/Art/UI/Frames/Frame_CtaPlank.png");
    -unity-slice-left: 48; -unity-slice-right: 48; -unity-slice-top: 36; -unity-slice-bottom: 40;
    -unity-slice-scale: 1px;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-left-radius: 0; border-bottom-right-radius: 0;
    /* centred on the plank face: the 3D lip adds a little at the bottom, so only 2 px more there */
    padding-top: 22px; padding-bottom: 24px;
}
.cw-btn--wood {
    background-image: url("project://database/Assets/_Game/Art/UI/Frames/Frame_WoodPanel.png");
    -unity-slice-left: 40; -unity-slice-right: 40; -unity-slice-top: 40; -unity-slice-bottom: 40;
    -unity-slice-scale: 0.6px;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    border-top-left-radius: 0; border-top-right-radius: 0; border-bottom-left-radius: 0; border-bottom-right-radius: 0;
}
/* A disabled button must still read as text: dim the face, keep the outlined label. */
.cw-btn:disabled { opacity: 1; -unity-background-image-tint-color: rgb(150, 140, 128); color: rgb(236, 226, 206); }

/* ============================================================================
   SESSION END  (small panel)
   ============================================================================ */
.cw-se-panel {
    width: 1178px; max-width: 88%;
    align-items: center; justify-content: center;
    padding-top: 49px; padding-bottom: 49px; padding-left: 57px; padding-right: 57px;
    background-color: rgb(42, 26, 12);
    background-image: url("project://database/Assets/_Game/Art/UI/Atoms/PanelFrame.png");
    -unity-background-scale-mode: stretch-to-fill;
    border-top-left-radius: 30px; border-top-right-radius: 30px;
    border-bottom-left-radius: 30px; border-bottom-right-radius: 30px;
}
.cw-se-title {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/LilitaOne-Regular.ttf");
    font-size: 72px; letter-spacing: 4px; color: rgb(245, 200, 66); -unity-text-align: middle-center;
}
.cw-se-reason {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/Nunito-Bold.ttf");
    font-size: 34px; color: rgb(254, 245, 224); -unity-text-align: middle-center; margin-top: 27px;
}
.cw-se-countdown {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/Nunito-Bold.ttf");
    font-size: 30px; color: rgb(196, 160, 96); -unity-text-align: middle-center; margin-top: 15px;
}

/* ============================================================================
   INTRO COUNTDOWN  (topmost, non-interactive)
   ============================================================================ */
.cw-intro-glow {
    position: absolute; width: 1064px; height: 1064px;
    background-image: url("project://database/Assets/_Game/Art/UI/Atoms/RadialGlow.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgba(245, 200, 66, 0.5);
}
.cw-intro-number {
    -unity-font-definition: url("project://database/Assets/_Game/Resources/Fonts/LilitaOne-Regular.ttf");
    font-size: 342px; color: rgb(245, 200, 66); -unity-text-align: middle-center;
}
/* The GET READY ribbon sits below the number */
.cw-overlay--introdim .cw-me-ribbon--subdued { position: absolute; bottom: 22%; }
