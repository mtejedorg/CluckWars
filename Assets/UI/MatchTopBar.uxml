<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/UI/Styles/CluckWarsTokens.uss" />
    <ui:Style src="project://database/Assets/UI/Styles/MatchTopBar.uss" />
    <ui:Style src="project://database/Assets/UI/Styles/YouMark.uss" />

    <ui:VisualElement name="TopBarRoot" class="cw-topbar" picking-mode="Ignore">
        <ui:VisualElement name="TopBarLayout" class="cw-topbar-layout" picking-mode="Ignore">
            
            <!-- ===== LEFT: Ranked Leaderboard ===== -->
            <ui:VisualElement name="LeaderboardContainer" class="cw-lb-container" picking-mode="Ignore">
                <ui:VisualElement name="LeaderboardPanel" class="cw-lb-panel" picking-mode="Ignore">
                    
                    <!-- Death Mark draw: one highlight moved per frame over the rows (MatchHudController, style.translate). -->
                    <ui:VisualElement name="LbDrawHighlight" class="cw-lb-draw" picking-mode="Ignore" />

                    <!-- 4 fixed rows for the leaderboard, populated by controller (hidden until it ranks a base;
                         every placeholder is a UiText key or blank, round-2 finding 14) -->
                    <ui:VisualElement name="LbRow0" class="cw-lb-row" picking-mode="Ignore" style="display: none;">
                        <ui:Label name="LbOrd0" text="@hud.rank.1" class="cw-lb-ord" picking-mode="Ignore" />
                        <ui:VisualElement name="LbDot0" class="cw-lb-dot" picking-mode="Ignore">
                            <ui:VisualElement name="LbSkull0" class="cw-lb-skull" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:Label name="LbName0" text="" class="cw-lb-name" picking-mode="Ignore" />
                        <ui:VisualElement class="cw-lb-bar-trough" picking-mode="Ignore">
                            <ui:VisualElement name="LbBarFill0" class="cw-lb-bar-fill" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:Label name="LbScore0" text="" class="cw-lb-score" picking-mode="Ignore" />
                    </ui:VisualElement>

                    <ui:VisualElement name="LbRow1" class="cw-lb-row" picking-mode="Ignore" style="display: none;">
                        <ui:Label name="LbOrd1" text="@hud.rank.2" class="cw-lb-ord" picking-mode="Ignore" />
                        <ui:VisualElement name="LbDot1" class="cw-lb-dot" picking-mode="Ignore">
                            <ui:VisualElement name="LbSkull1" class="cw-lb-skull" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:Label name="LbName1" text="" class="cw-lb-name" picking-mode="Ignore" />
                        <ui:VisualElement class="cw-lb-bar-trough" picking-mode="Ignore">
                            <ui:VisualElement name="LbBarFill1" class="cw-lb-bar-fill" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:Label name="LbScore1" text="" class="cw-lb-score" picking-mode="Ignore" />
                    </ui:VisualElement>

                    <ui:VisualElement name="LbRow2" class="cw-lb-row" picking-mode="Ignore" style="display: none;">
                        <ui:Label name="LbOrd2" text="@hud.rank.3" class="cw-lb-ord" picking-mode="Ignore" />
                        <ui:VisualElement name="LbDot2" class="cw-lb-dot" picking-mode="Ignore">
                            <ui:VisualElement name="LbSkull2" class="cw-lb-skull" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:Label name="LbName2" text="" class="cw-lb-name" picking-mode="Ignore" />
                        <ui:VisualElement class="cw-lb-bar-trough" picking-mode="Ignore">
                            <ui:VisualElement name="LbBarFill2" class="cw-lb-bar-fill" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:Label name="LbScore2" text="" class="cw-lb-score" picking-mode="Ignore" />
                    </ui:VisualElement>

                    <ui:VisualElement name="LbRow3" class="cw-lb-row" picking-mode="Ignore" style="display: none;">
                        <ui:Label name="LbOrd3" text="@hud.rank.4" class="cw-lb-ord" picking-mode="Ignore" />
                        <ui:VisualElement name="LbDot3" class="cw-lb-dot" picking-mode="Ignore">
                            <ui:VisualElement name="LbSkull3" class="cw-lb-skull" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:Label name="LbName3" text="" class="cw-lb-name" picking-mode="Ignore" />
                        <ui:VisualElement class="cw-lb-bar-trough" picking-mode="Ignore">
                            <ui:VisualElement name="LbBarFill3" class="cw-lb-bar-fill" picking-mode="Ignore" />
                        </ui:VisualElement>
                        <ui:Label name="LbScore3" text="" class="cw-lb-score" picking-mode="Ignore" />
                    </ui:VisualElement>

                </ui:VisualElement>
            </ui:VisualElement>

            <!-- ===== MIDDLE: the Death Mark victim's MARKED! toast (landscape: between board and timer; portrait: just
                 under the band, MatchTopBar.uss) ===== -->
            <ui:VisualElement name="MarkToastSlot" class="cw-mark-toast-slot" picking-mode="Ignore">
                <ui:VisualElement name="MarkToast" class="cw-mark-toast" picking-mode="Ignore">
                    <ui:VisualElement name="MarkToastSkull" class="cw-mark-toast-skull" picking-mode="Ignore" />
                    <ui:Label name="MarkToastText" text="@mark.toast" class="cw-mark-toast-text" picking-mode="Ignore" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- ===== RIGHT: Embossed Timer + goal pill under it, right-aligned (WP7 / decision C5, both orientations:
                 the pill no longer hangs under the board into the arena, CW-212) ===== -->
            <ui:VisualElement name="TimerContainer" class="cw-timer-container" picking-mode="Ignore">
                <!-- The timer and the Death Mark victim's clock pill (row-reverse: the pill sits left of the timer in
                     landscape; a column with the pill under the timer in portrait). -->
                <ui:VisualElement name="TimerRow" class="cw-timer-row" picking-mode="Ignore">
                    <ui:Label name="MatchTimer" text="@hud.timer.none" class="cw-timer" picking-mode="Ignore" />
                    <ui:VisualElement name="MarkClock" class="cw-mark-clock" picking-mode="Ignore">
                        <ui:VisualElement name="MarkClockSkull" class="cw-mark-clock-skull" picking-mode="Ignore" />
                        <ui:Label name="MarkClockText" text="" class="cw-mark-clock-text" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Label name="WinTargetBadge" text="" class="cw-target-badge" picking-mode="Ignore" />
            </ui:VisualElement>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
