<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <!-- Cluck Wars — THE COOP (menu overhaul Phase 1, 2026-10-06).

         A player LINEUP: four seats, each a big chicken on a pedestal tinted in the seat's
         player colour (Okabe-Ito), a nameplate, the four moves and a ready check (gold/ink
         status badge, never a green button). A compact rule-chips row replaces the old HOUSE
         RULES card. When every seat is ready a short READY! banner reveals once (instant under
         reduced motion). START MATCH is the one green CTA.

         Seats are built ONCE in MenuUiController.BuildLobby and refreshed per visit.
         Binding contract (by name): BackBtn, StartBtn, CopyBtn, ShareBtn, InviteCard,
         CodeTiles, JoinCard, LobbyJoinField, StatusPill/StatusDot/StatusCount/StatusText,
         SetTime, SetGoal (filled from MatchConfig; LobbyMatchSettingsTests keeps them blank),
         PlayerGrid (seat host), ReadyBanner, LobbyStatus.

         Sizes follow the MOBILE SIZING CONTRACT at the top of CluckWarsTheme.uss. -->
    <ui:Style src="project://database/Assets/UI/Styles/CluckWarsTheme.uss" />

    <ui:VisualElement name="LobbyPage" class="cw-screen cw-page">

        <ui:VisualElement class="cw-page-header">
            <ui:Button name="BackBtn" text="@nav.back" class="cw-home-btn" />
            <ui:VisualElement class="cw-ribbon">
                <ui:Label text="@screen.lobby.title" class="cw-title" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Rule chips: TIME / GOAL / MODE / ARENA. -->
        <ui:VisualElement name="RuleChips" class="cw-rule-chips">
            <ui:Label text="@lobby.rules" class="cw-rule-chips__head" />
            <ui:VisualElement class="cw-rule-chip">
                <ui:Label text="@lobby.setting.time" class="cw-rule-chip__k" /><ui:Label name="SetTime" text="" class="cw-rule-chip__v" />
            </ui:VisualElement>
            <ui:VisualElement class="cw-rule-chip">
                <ui:Label text="@lobby.setting.goal" class="cw-rule-chip__k" /><ui:Label name="SetGoal" text="" class="cw-rule-chip__v" />
            </ui:VisualElement>
            <ui:VisualElement class="cw-rule-chip">
                <ui:Label text="@lobby.setting.mode" class="cw-rule-chip__k" /><ui:Label name="SetMode" text="@lobby.value.mode" class="cw-rule-chip__v" />
            </ui:VisualElement>
            <ui:VisualElement class="cw-rule-chip">
                <ui:Label text="@lobby.setting.arena" class="cw-rule-chip__k" /><ui:Label text="@lobby.value.arena" class="cw-rule-chip__v" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- The lineup: MenuUiController builds four .cw-seat children once. -->
        <ui:VisualElement name="PlayerGrid" class="cw-lineup" />

        <ui:VisualElement name="CoopBottom" class="cw-coop-bottom">
            <ui:VisualElement class="cw-coop-left">
                <ui:VisualElement name="StatusPill" class="cw-status-pill">
                    <ui:VisualElement name="StatusDot" class="cw-status-dot" />
                    <ui:Label name="StatusCount" text="" class="cw-status-count" />
                    <ui:Label name="StatusText" text="" class="cw-status-text" />
                </ui:VisualElement>

                <!-- Invite code (host mode) -->
                <ui:VisualElement name="InviteCard" class="cw-raised cw-lobby-card">
                    <ui:Label text="@lobby.invite.label" class="cw-lobby-cardlabel" />
                    <ui:VisualElement class="cw-lobby-btnrow">
                        <ui:VisualElement name="CodeTiles" class="cw-code-tiles" />
                        <ui:Button name="ShareBtn" text="@btn.share" class="cw-mini-btn" />
                        <ui:Button name="CopyBtn" text="@btn.copy" class="cw-mini-btn" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Join code entry (join mode) -->
                <ui:VisualElement name="JoinCard" class="cw-raised cw-lobby-card cw-hidden">
                    <ui:Label text="@lobby.join.label" class="cw-lobby-cardlabel" />
                    <ui:TextField name="LobbyJoinField" class="cw-input" />
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- One-shot READY! banner (all seats ready). Display + reveal driven from C#. -->
            <ui:VisualElement class="cw-coop-center">
                <ui:VisualElement name="ReadyBanner" class="cw-ready-banner" style="display: none;" picking-mode="Ignore">
                    <ui:Label text="@lobby.allReady" class="cw-title cw-ready-banner__label" />
                </ui:VisualElement>
            </ui:VisualElement>

            <ui:VisualElement class="cw-coop-right">
                <ui:Button name="StartBtn" text="@btn.start" class="cw-btn cw-btn--green cw-page-cta" />
                <ui:Label name="LobbyStatus" text="" class="cw-lobby-error" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
