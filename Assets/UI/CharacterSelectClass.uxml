<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <!-- Cluck Wars — STEP 1 "PICK YOUR BIRD" (menu overhaul Phase 1, 2026-10-06).

         Phase 4: a selected tile = scale + gold border + ink ring (.cw-class-tile__ring) + corner
         check (.cw-class-tile__check, drawn in USS); the hero is ~1.4x and sways (decision 4).

         Four big portrait tiles (class colour fill, big chicken, name + role) and ONE hero
         area for the selected class: big chicken on a class-tinted stage, class name, quote,
         strong/weak callouts, two PERK badges (tap = select that perk and show its detail)
         and the selected perk's STARTERS as icon chips. GEAR UP is the one green CTA.

         Everything here is built ONCE; MenuUiController.RefreshClassSelect only toggles
         classes and rewrites labels. Binding contract (queried by name):
           HomeBtn, NextBtn
           ClassWarrior / ClassSpeedy / ClassFatty / ClassAssassin  (tiles; ChipNames order)
           <TileName>Art                                           (tile chicken)
           Hero, HeroStage, PreviewGlow, PreviewChicken, PreviewName, PreviewQuote  (PreviewDisc = the
           hay-bale pedestal, pure USS, not queried),
           RoleCalloutStrong, RoleCalloutWeak
           PerkBadgeA / PerkBadgeB (children by class .cw-perk-badge__icon / __name / __line), PerkDetail
           StarterRow, StarterChip0 / StarterChip1 (children .cw-starter-chip__icon / __name)

         Sizes follow the MOBILE SIZING CONTRACT at the top of CluckWarsTheme.uss. -->
    <ui:Style src="project://database/Assets/UI/Styles/CluckWarsTheme.uss" />

    <ui:VisualElement name="CharacterSelectClassPage" class="cw-screen cw-page">

        <ui:VisualElement class="cw-page-header">
            <ui:Button name="HomeBtn" text="@nav.home" class="cw-home-btn" />
            <ui:VisualElement class="cw-ribbon">
                <ui:Label text="@screen.class.title" class="cw-title" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="Body" class="cw-pick-body">

            <ui:VisualElement name="ClassList" class="cw-class-tiles">
                <ui:VisualElement name="ClassWarrior" class="cw-class-tile">
                    <ui:VisualElement class="cw-class-tile__ring" picking-mode="Ignore" />
                    <ui:VisualElement name="ClassWarriorArt" class="cw-chicken cw-class-tile__art" picking-mode="Ignore" />
                    <ui:Label text="@class.warrior.short" class="cw-class-tile__name" picking-mode="Ignore" />
                    <ui:Label text="@role.warrior" class="cw-class-tile__role" picking-mode="Ignore" />
                    <ui:VisualElement class="cw-class-tile__check" picking-mode="Ignore"><ui:VisualElement class="cw-class-tile__check-mark" picking-mode="Ignore" /></ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="ClassSpeedy" class="cw-class-tile">
                    <ui:VisualElement class="cw-class-tile__ring" picking-mode="Ignore" />
                    <ui:VisualElement name="ClassSpeedyArt" class="cw-chicken cw-class-tile__art" picking-mode="Ignore" />
                    <ui:Label text="@class.speedy.short" class="cw-class-tile__name" picking-mode="Ignore" />
                    <ui:Label text="@role.speedy" class="cw-class-tile__role" picking-mode="Ignore" />
                    <ui:VisualElement class="cw-class-tile__check" picking-mode="Ignore"><ui:VisualElement class="cw-class-tile__check-mark" picking-mode="Ignore" /></ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="ClassFatty" class="cw-class-tile">
                    <ui:VisualElement class="cw-class-tile__ring" picking-mode="Ignore" />
                    <ui:VisualElement name="ClassFattyArt" class="cw-chicken cw-class-tile__art" picking-mode="Ignore" />
                    <ui:Label text="@class.fatty.short" class="cw-class-tile__name" picking-mode="Ignore" />
                    <ui:Label text="@role.fatty" class="cw-class-tile__role" picking-mode="Ignore" />
                    <ui:VisualElement class="cw-class-tile__check" picking-mode="Ignore"><ui:VisualElement class="cw-class-tile__check-mark" picking-mode="Ignore" /></ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="ClassAssassin" class="cw-class-tile">
                    <ui:VisualElement class="cw-class-tile__ring" picking-mode="Ignore" />
                    <ui:VisualElement name="ClassAssassinArt" class="cw-chicken cw-class-tile__art" picking-mode="Ignore" />
                    <ui:Label text="@class.assassin.short" class="cw-class-tile__name" picking-mode="Ignore" />
                    <ui:Label text="@role.assassin" class="cw-class-tile__role" picking-mode="Ignore" />
                    <ui:VisualElement class="cw-class-tile__check" picking-mode="Ignore"><ui:VisualElement class="cw-class-tile__check-mark" picking-mode="Ignore" /></ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>

            <!-- Hero: cream card. Stage (class-tinted platform + big chicken) beside the text. -->
            <ui:VisualElement name="Hero" class="cw-hero cw-raised">
                <ui:VisualElement name="HeroStage" class="cw-hero__stage" picking-mode="Ignore">
                    <ui:VisualElement name="PreviewGlow" class="cw-radial-glow cw-hero__glow" />
                    <ui:VisualElement name="PreviewDisc" class="cw-hero__platform" />
                    <ui:VisualElement name="PreviewChicken" class="cw-chicken cw-hero__chicken" />
                </ui:VisualElement>

                <ui:VisualElement class="cw-hero__text">
                    <ui:Label name="PreviewName" text="@class.warrior.short" class="cw-hero__name" />
                    <ui:Label name="PreviewQuote" text="" class="cw-hero__quote" />

                    <ui:VisualElement name="RoleCallouts" class="cw-role-list">
                        <ui:VisualElement class="cw-role-row">
                            <ui:Label text="@glyph.plus" class="cw-role-glyph cw-role-glyph--pos" />
                            <ui:Label name="RoleCalloutStrong" text="" class="cw-role-callout cw-role-callout--strong" />
                        </ui:VisualElement>
                        <ui:VisualElement class="cw-role-row">
                            <ui:Label text="@glyph.minus" class="cw-role-glyph cw-role-glyph--neg" />
                            <ui:Label name="RoleCalloutWeak" text="" class="cw-role-callout cw-role-callout--weak" />
                        </ui:VisualElement>
                    </ui:VisualElement>

                    <ui:Label text="@label.perk" class="cw-small-head" />
                    <ui:VisualElement class="cw-perk-row">
                        <ui:Button name="PerkBadgeA" class="cw-perk-badge">
                            <ui:VisualElement class="cw-perk-badge__head" picking-mode="Ignore">
                                <ui:VisualElement class="cw-perk-badge__icon" picking-mode="Ignore" />
                                <ui:Label text="" class="cw-perk-badge__name" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:Label text="" class="cw-perk-badge__line" picking-mode="Ignore" />
                        </ui:Button>
                        <ui:Button name="PerkBadgeB" class="cw-perk-badge">
                            <ui:VisualElement class="cw-perk-badge__head" picking-mode="Ignore">
                                <ui:VisualElement class="cw-perk-badge__icon" picking-mode="Ignore" />
                                <ui:Label text="" class="cw-perk-badge__name" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <ui:Label text="" class="cw-perk-badge__line" picking-mode="Ignore" />
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:Label name="PerkDetail" text="" class="cw-perk-detail" />

                    <ui:VisualElement name="StarterRow" class="cw-starter-row">
                        <ui:Label text="@label.starters" class="cw-small-head cw-starter-row__label" />
                        <ui:VisualElement name="StarterChip0" class="cw-starter-chip">
                            <ui:VisualElement class="cw-starter-chip__icon" />
                            <ui:Label text="" class="cw-starter-chip__name" />
                        </ui:VisualElement>
                        <ui:VisualElement name="StarterChip1" class="cw-starter-chip">
                            <ui:VisualElement class="cw-starter-chip__icon" />
                            <ui:Label text="" class="cw-starter-chip__name" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="cw-page-footer">
            <ui:Button name="NextBtn" text="@btn.next" class="cw-btn cw-btn--green cw-page-cta" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
