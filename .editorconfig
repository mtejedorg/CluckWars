# EditorConfig — keeps editors (VSCode, Rider, Unity's external script editor,
# Visual Studio) consistent with the LF-everywhere rule we ship in
# .gitattributes. Without this, IDEs on Windows happily save files as CRLF
# and re-introduce the churn on every edit.
#
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Visual Studio solutions historically use CRLF; keep that to avoid VS warnings.
[*.sln]
end_of_line = crlf

# Markdown allows trailing whitespace as a hard line break — don't strip it.
[*.md]
trim_trailing_whitespace = false
indent_size = 2

# Web / data formats commonly use 2-space indent.
[*.{json,yml,yaml,xml,html,css,js,ts}]
indent_size = 2

# Unity YAML and project assets — don't reformat indent (Unity controls it).
[*.{unity,prefab,asset,meta,controller,anim,mat,asmdef,asmref}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
